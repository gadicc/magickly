/**
 * KEPT FOR REFERENCE ONLY, with `roseSigilOptimizer.ts.old`: the tests of
 * the retired optimiser (plan 088, decision 7). Not run; its imports no
 * longer resolve. The optimiser's tests from `roseSigilGeometry.test.ts`
 * are appended.
 */
import { afterEach, describe, expect, it, vi } from "vitest";

afterEach(() => {
  vi.doUnmock("nlopt-js");
  vi.resetModules();
});

describe("optimiser loading", () => {
  it("does not cache a failed load and recovers on the next call", async () => {
    vi.resetModules();
    const actual = await vi.importActual<{ default: object }>("nlopt-js");
    let failOnce = true;
    vi.doMock("nlopt-js", () => ({
      default: new Proxy(actual.default, {
        get(target, property, receiver) {
          if (property === "ready" && failOnce) {
            failOnce = false;
            return Promise.reject(new Error("wasm unavailable"));
          }
          return Reflect.get(target, property, receiver);
        },
      }),
    }));
    const { optimizeSigilPoints } = await import("./roseSigilOptimizer.ts");
    const { sigilPoints } = await import("./roseSigilGeometry.ts");
    await expect(optimizeSigilPoints(sigilPoints("אב"))).rejects.toThrow(
      "wasm unavailable",
    );
    await expect(optimizeSigilPoints(sigilPoints("אב"))).resolves.toHaveLength(
      2,
    );
  });

  /** A stand-in for nlopt-js whose `ready` runs `onReady`, as its glue's load does. */
  const fakeNlopt = (onReady: () => void) => ({
    default: {
      get ready() {
        onReady();
        return Promise.resolve();
      },
      Algorithm: { LN_COBYLA: 0 },
      Optimize: class {
        setMaxObjective() {}
        setMaxeval() {}
        optimize(start: number[]) {
          return { x: start };
        }
      },
      GC: { flush() {} },
    },
  });

  it("removes the process handlers nlopt adds in Node, and only those", async () => {
    vi.resetModules();
    const kept = () => {};
    const added = () => {};
    process.on("uncaughtException", kept);
    try {
      vi.doMock("nlopt-js", () =>
        fakeNlopt(() => process.on("uncaughtException", added)),
      );
      const { optimizeSigilPoints } = await import("./roseSigilOptimizer.ts");
      const { sigilPoints } = await import("./roseSigilGeometry.ts");
      await expect(
        optimizeSigilPoints(sigilPoints("אב")),
      ).resolves.toHaveLength(2);
      const listeners = process.listeners("uncaughtException");
      expect(listeners).toContain(kept);
      expect(listeners).not.toContain(added);
    } finally {
      process.removeListener("uncaughtException", kept);
      process.removeListener("uncaughtException", added);
    }
  });

  it("loads where there is no Node process to clean up after", async () => {
    vi.resetModules();
    vi.doMock("nlopt-js", () => fakeNlopt(() => {}));
    const { optimizeSigilPoints } = await import("./roseSigilOptimizer.ts");
    // A browser's `process` shim, if any, has no listeners().
    Object.defineProperty(process, "listeners", {
      value: undefined,
      configurable: true,
      writable: true,
    });
    try {
      await expect(optimizeSigilPoints([{ x: 1, y: 2 }])).resolves.toEqual([
        { x: 1, y: 2 },
      ]);
    } finally {
      // The own property hid EventEmitter's method; removing it restores it.
      Reflect.deleteProperty(process, "listeners");
    }
  });
});

// From roseSigilGeometry.test.ts, which imported sigilPoints from
// ./roseSigilGeometry.ts and objective and pointsToArray from
// ./roseSigilOptimizer.ts (then ./roseSigilInternals.ts).
describe("the optimiser", () => {
  it("scores wider angles higher and penalises drifting far from the letter", () => {
    const points = sigilPoints("אבג");
    const base = objective(points, pointsToArray(points));
    const drifted = pointsToArray(points);
    drifted[0] += 20;
    expect(objective(points, drifted)).toBeLessThan(base);
  });

  it("optimises deterministically within the evaluation bound", async () => {
    const listeners = () => ({
      rejection: process.listeners("unhandledRejection"),
      exception: process.listeners("uncaughtException"),
    });
    const before = listeners();
    const points = sigilPoints("גדי");
    const first = await optimizeSigilPoints(points);
    const second = await optimizeSigilPoints(points);
    expect(first).toEqual(second);
    expect(first).toHaveLength(3);
    for (const [index, point] of first.entries()) {
      expect(
        Math.hypot(point.x - points[index].x, point.y - points[index].y),
      ).toBeLessThan(10);
    }
    expect(await optimizeSigilPoints([])).toEqual([]);
    // Emscripten's glue registers abort handlers on the process at load time;
    // they must not survive, or every later server diagnostic becomes a WASM
    // abort message.
    const after = listeners();
    expect(after.rejection).toEqual(before.rejection);
    expect(after.exception).toEqual(before.exception);
    expect(
      after.rejection.some((listener) => /abort\(/.test(String(listener))),
    ).toBe(false);
    const started = performance.now();
    const long = await optimizeSigilPoints(sigilPoints("א".repeat(32)));
    expect(long).toHaveLength(32);
    expect(performance.now() - started).toBeLessThan(10_000);
  }, 30_000);
});
