{
  // The publish emit, into lib/ (plan 080, decision 7). `files` names the
  // entry points the published exports reach, and tsc follows their
  // imports, so tests are never compiled; vendor.d.ts types lune for the
  // check and emits nothing.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [],
  "files": [
    "src/vendor.d.ts",
    "src/astrology/Kamea.tsx",
    "src/astrology/KameaSigil.tsx",
    "src/astrology/MercuryWidget.tsx",
    "src/astrology/mercuryRetrograde.ts",
    "src/astrology/Moon.tsx",
    "src/astrology/MoonWidget.tsx",
    "src/astrology/PlanetarySeal.tsx",
    "src/astrology/PlanetarySpirit.tsx",
    "src/chakras/Chakras.tsx",
    "src/enochian/pyramidMarks.tsx",
    "src/enochian/Tablet.tsx",
    "src/gd/FylfotCross.tsx",
    "src/gd/GradeTree.tsx",
    "src/gd/hall/editor.ts",
    "src/gd/hall/index.ts",
    "src/gd/hall/presets/index.ts",
    "src/gd/hall/tags.ts",
    "src/gd/Lamen.tsx",
    "src/gd/lamenGrades.ts",
    "src/gd/RoseSigil.tsx",
    "src/gd/roseSigilGeometry.ts",
    "src/gd/roseSigilLayout.ts",
    "src/gd/roseSigilStyles.tsx",
    "src/gd/RoseSigilImage.tsx",
    "src/gd/SevenBranchedCandlestick.tsx",
    "src/gd/TableOfShewbread.tsx",
    "src/kabbalah/fieldPath.ts",
    "src/kabbalah/TreeOfLife.tsx",
    "src/sigil/ink.ts",
