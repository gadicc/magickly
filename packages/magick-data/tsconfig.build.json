{
  // The publish emit, into lib/. `files` names the entry points the published
  // exports reach and tsc follows their imports, so the checks, the build and
  // the tests are never compiled. The Enochian dictionary is not one of them
  // (plan 052, decided on 3 October).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [],
  "files": [
    "src/data.ts",
    "src/tools.ts",
    "src/assemble.ts",
    "src/rowOf.ts",
    "src/pathTarget.ts",
    "src/tables.ts",
    "src/graph.ts",
    "src/types.ts",
    "src/rows.ts",
    "src/alchemy/Elementals.ts",
    "src/alchemy/Elements.ts",
    "src/alchemy/Symbols.ts",
    "src/alchemy/Terms.ts",
    "src/astrology/Houses.ts",
    "src/astrology/Planets.ts",
    "src/astrology/Zodiac.ts",
    "src/enochian/Letters.ts",
    "src/enochian/Tablets.ts",
    "src/gd/Grades.ts",
    "src/geomancy/Houses.ts",
    "src/geomancy/Tetragrams.ts",
    "src/HebrewLetters.ts",
    "src/kabbalah/AngelicOrders.ts",
    "src/kabbalah/Archangels.ts",
    "src/kabbalah/ChristianChoirs.ts",
    "src/kabbalah/FourWorlds.ts",
    "src/kabbalah/GodNames.ts",
    "src/kabbalah/Kerubim.ts",
    "src/kabbalah/Paths.ts",
    "src/kabbalah/Sephirot.ts",
    "src/kabbalah/TribesOfIsrael.ts",
    "src/kabbalah/SeventyTwoAngels.ts",
    "src/gd/Degrees.ts",
    "src/kabbalah/Souls.ts",
    "src/Chakras.ts",
    "src/body/Parts.ts",
    "src/materia/Stones.ts",
