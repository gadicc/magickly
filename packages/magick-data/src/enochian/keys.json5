        {"english": "Milstones,", "readings": {"casaubon1659": {"word": "AVINY", "pronunciation": "A vi ny."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
