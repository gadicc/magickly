        {"english": "let them serve you,", "readings": {"casaubon1659": {"word": "ABOAPRI", "pronunciation": "A bó a pri."}, "equinox1912no8": {"word": "aboaperi"}}, "sources": [{"work": "casaubon1659", "page": 207, "leaf": 296}, {"work": "equinox1912no8", "page": 126, "leaf": 156, "field": "gd"}]},
