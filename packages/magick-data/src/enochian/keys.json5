        {"english": "the governour", "readings": {"casaubon1659": {"word": "TABAAM", "pronunciation": "Tabaam"}, "equinox1912no8": {"word": "tabaanu"}}, "note": "p.200 n289 \"Ils Tabaam\" (M, not N); Crowley tabaanu; the dictionary has both TABAAN and TABAAM.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 200, "leaf": 289, "field": "enochian"}, {"work": "equinox1912no8", "page": 121, "leaf": 151, "field": "gd"}]},
