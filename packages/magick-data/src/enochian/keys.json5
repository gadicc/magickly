        {"english": "of Wormwood,", "readings": {"casaubon1659": {"word": "TATAN", "pronunciation": "Ta tan."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od"}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "of the marrow", "readings": {"casaubon1659": {"word": "TRANAN", "pronunciation": "Tra nan."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "of salt", "readings": {"casaubon1659": {"word": "BALYE", "pronunciation": "Ba ly e."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "have setled", "readings": {"casaubon1659": {"word": "ALAR", "pronunciation": "A lar."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "their feet", "readings": {"casaubon1659": {"word": "LUSDA", "pronunciation": "Lus da."}}, "note": "Crowley prints busada (B) for Casaubon's LUSDA", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "in the West,", "readings": {"casaubon1659": {"word": "SOBOLN", "pronunciation": "So boln.", "printed": "SOʻBOLN"}}, "note": "a raised mark between O and B in the caps", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
