        {"english": "your viols.", "readings": {"casaubon1659": {"word": "OFAFAFE", "pronunciation": "O fa fa fe.", "printed": "O...AFE"}, "equinox1912no8": {"word": "ofafafe"}}, "note": "Damaged in the print. The capitals \"O...AFE\"; F, A, F from the pronunciation \"O fa fa fe.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}]},
