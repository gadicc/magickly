  "keys": [
    {
      "key": 1,
      "casaubonCall": 1,
      "dictated": "Friday 13 April 1584 (entries 86-72 in the morning, 71-69 \"The same Friday after Noon, circa 3. horam\") and Saturday 14 April 1584 (68-1), Cracow; read backward, entries 86-69 letter by letter with the Table numbers, 68-1 as words",
      "note": "Casaubon's margin p.87 (n180): \"The first Call ended\"; E.K. calls it \"the mighty and first Call\". Received first.",
      "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "casaubon1659", "page": 80, "leaf": 173}, {"work": "casaubon1659", "page": 81, "leaf": 174}, {"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "casaubon1659", "page": 84, "leaf": 177}, {"work": "casaubon1659", "page": 85, "leaf": 178}, {"work": "casaubon1659", "page": 86, "leaf": 179}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659"], "covered": ["enochian", "english"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)", "the words Casaubon's print has damaged", "the Golden Dawn's reading"]},
