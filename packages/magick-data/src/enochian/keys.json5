    {
      "key": 8,
      "casaubonCall": 4,
      "dictated": "Saturday 14 May 1584, Cracow (\"Saturday, 14 Maii, Mane hora 6 Fere. Cracoviae\", p.118 n207); Keys 5-10 are the first to sixth Calls of that morning (p.129 \"This is the fifth of this day\", p.133 \"This is the sixth\")",
      "note": "not numbered at dictation (p.127 \"This is the end of that\"); p.192 margin \"Δ 4 / 8\" English given: Thursday 5 July 1584, Cracow (\"Thursday, Cracoviae, Julii 5. Mane, hora 8. fere\", p.189 n278) (p.192, no new date heading between p.189 and p.192).",
      "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659", "equinox1912no8"], "covered": ["enochian", "english", "gd"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)", "the words Casaubon's print has damaged"]},
      "rows": [
        {"english": "The midday the first,", "readings": {"casaubon1659": {"word": "BAZMELO", "pronunciation": "Baz me lo."}, "equinox1912no8": {"word": "Bazodemelo"}}, "note": "a small mark (\"¾\"?) in the margin before the capitals", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "is as", "readings": {"casaubon1659": {"word": "ITA", "pronunciation": "I ta"}, "equinox1912no8": {"word": "i ta", "marker": "split"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "the third Heaven", "readings": {"casaubon1659": {"word": "PIRIPSON", "pronunciation": "..rip son.", "printed": "PIRIPS▪N (blotted)"}, "equinox1912no8": {"word": "pi-ripesonu"}}, "note": "Damaged in the print. A blot covers the last letters of the capitals and the first of the pronunciation; O, N from the pronunciation \"..rip son.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "made", "readings": {"casaubon1659": {"word": "OLN", "pronunciation": "Oln."}, "equinox1912no8": {"word": "olanu"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "of Hiacinct pillars", "readings": {"casaubon1659": {"word": "NAZAVABH", "pronunciation": "Na za vábh."}, "equinox1912no8": {"word": "Na-zodavabebe"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "26.", "readings": {"casaubon1659": {"word": "OX", "pronunciation": "Ox."}, "equinox1912no8": {"word": "ox"}}, "note": "beside \"26.\" p.192: \"Nal ... Ox: And that you have not.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "In whom", "readings": {"casaubon1659": {"word": "CASARMG", "pronunciation": "Casarmg."}, "equinox1912no8": {"word": "Casaremeji"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "the Elders", "readings": {"casaubon1659": {"word": "VRAN", "pronunciation": "V rán.", "printed": "G or V RAN"}, "equinox1912no8": {"word": "varanu"}}, "uncertain": true, "note": "capitals print \"G or V RAN\"; the pronunciation \"V rán.\" and Crowley (varanu) have V. Uncertain first letter", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "are", "readings": {"casaubon1659": {"word": "CHIS", "pronunciation": "Chis."}, "equinox1912no8": {"word": "cahisa"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "become strange,", "readings": {"casaubon1659": {"word": "VGEG", "pronunciation": "V geg."}, "equinox1912no8": {"word": "vaugeji"}}, "gdEnglish": "are become strong", "note": "Casaubon prints \"strange\" (checked at full size); Crowley and the app's earlier text (2023) have \"strong\". Casaubon p.192 (English), p.125 (Enochian).", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "which I have prepared", "readings": {"casaubon1659": {"word": "DSABRAMG", "pronunciation": "Dsabramg. [g not as dg.]", "printed": "..SABRAMG"}, "equinox1912no8": {"word": "asa berameji", "marker": "split"}}, "note": "Damaged in the print. The capitals \"..SABRAMG\"; D from the pronunciation \"Dsabramg.\"; English two lines \"which\" / \"I have prepared\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "for my own righteousnesse,", "readings": {"casaubon1659": {"word": "BALTOHA", "pronunciation": "Bal to ha."}, "equinox1912no8": {"word": "balatoha"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "saith the Lord,", "readings": {"casaubon1659": {"word": "GOHOIAD", "pronunciation": "Go hó i ad."}, "equinox1912no8": {"word": "goho IAD", "marker": "split"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "whose long continuance", "readings": {"casaubon1659": {"word": "SOLAMIAN", "pronunciation": "So lá mi an."}, "equinox1912no8": {"word": "Soba miame", "marker": "split"}}, "note": "Crowley \"Soba miame\" for Casaubon's SOLAMIAN", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "shall be", "readings": {"casaubon1659": {"word": "TRIAN", "pronunciation": "Tri an."}, "equinox1912no8": {"word": "tarianu"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "as Buckles", "readings": {"casaubon1659": {"word": "TALOLCIS", "pronunciation": "Ta lól cis or sis."}, "equinox1912no8": {"word": "ta lolacis", "marker": "split"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "to the stooping Dragons,", "readings": {"casaubon1659": {"word": "ABAIUONIN", "pronunciation": "A ba i uo nin."}, "equinox1912no8": {"word": "Abaivoninu"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "O D."}, "equinox1912no8": {"word": "od"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "like unto the Harvest", "readings": {"casaubon1659": {"word": "AZIAGIAR", "pronunciation": "A zi á gi er."}, "equinox1912no8": {"word": "azodiajiere"}}, "note": "margin: \"He putteth his feet on all these letters.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "of a Widow.", "readings": {"casaubon1659": {"word": "RIOR", "pronunciation": "Rior."}, "equinox1912no8": {"word": "riore"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "How many are there", "readings": {"casaubon1659": {"word": "IRGILCHISDA", "pronunciation": "Ir gil chis da."}, "equinox1912no8": {"word": "Irejila cahisa da", "marker": "split"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "which remain", "readings": {"casaubon1659": {"word": "DSPAAOX", "pronunciation": "Dspá a ox.", "printed": "DSPAAOX."}, "equinox1912no8": {"word": "das pa-aox", "marker": "split"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
        {"english": "in the glory", "readings": {"casaubon1659": {"word": "BUFD", "pronunciation": "Bufd."}, "equinox1912no8": {"word": "busada"}}, "note": "capitals print a roman F (checked at full size); Crowley busada; perhaps a long s misread as f in 1659. Kept as printed", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "equinox1912no8", "page": 115, "leaf": 145, "field": "gd"}]},
