        {"english": "for why?", "readings": {"casaubon1659": {"word": "BAGLE", "pronunciation": "Bá gle."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 121, "leaf": 210, "field": "enochian"}]},
        {"english": "Our Lord and Master", "readings": {"casaubon1659": {"word": "GEIAD", "pronunciation": "ie in as ien tle iad-as iade, / Ge jad.", "printed": "........ (lost)"}}, "uncertain": true, "note": "DAMAGED. Caps line printed as dots; word from the pronunciation \"Ge jad.\" (j = I), with a pronunciation note above it ('ie in as ien tle, iad as iade'). Uncertain: no capitals survive, so spelling and word division rest on the pronunciation alone", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 121, "leaf": 210, "field": "enochian"}]},
        {"english": "is all one.", "readings": {"casaubon1659": {"word": "IL", "pronunciation": "i l.", "printed": "........ (lost)"}}, "uncertain": true, "note": "DAMAGED. Caps line printed as dots; word from the pronunciation \"i l.\". Uncertain whether Dee wrote one word or two (I L)", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 121, "leaf": 210, "field": "enochian"}]}
      ]
