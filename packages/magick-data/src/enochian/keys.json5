        {"english": "to you", "readings": {"casaubon1659": {"word": "NONCA", "pronunciation": "sa / Nonca."}, "equinox1912no8": {"word": "Nonuça"}}, "note": "pronunciation \"Nonca.\" with \"sa\" (long s) printed above it", "sources": [{"work": "casaubon1659", "page": 201, "leaf": 290}, {"work": "equinox1912no8", "page": 125, "leaf": 155, "field": "gd"}]},
