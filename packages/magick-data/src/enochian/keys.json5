        {"english": "their powers", "readings": {"casaubon1659": {"word": "LONSHIN", "dictated": "NIHSNOLDO", "pronunciation": "(as above)"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "are", "readings": {"casaubon1659": {"word": "CHIS", "dictated": "SIHC", "pronunciation": "Chis"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "as the first", "readings": {"casaubon1659": {"word": "TALO", "dictated": "OLAT", "pronunciation": "Ta l o"}}, "note": "Crowley prints this one Dee word as two, \"ta el-o\"", "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "456", "readings": {"casaubon1659": {"word": "CLA", "dictated": "ALC", "pronunciation": "Cla"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "Arise", "readings": {"casaubon1659": {"word": "TORGV", "dictated": "VGROT", "pronunciation": "Torgu"}}, "note": "Casaubon prints G in both columns; Crowley has Z (torzu). Possibly a misreading in the 1659 print; keep as printed, note", "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "you sons of pleasure", "readings": {"casaubon1659": {"word": "NORQVASAHI", "dictated": "IHASAVQRON", "pronunciation": "Nor qua sa hi"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "dictated": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "visit the earth", "readings": {"casaubon1659": {"word": "FGAOSGA", "dictated": "AGSOAGF", "pronunciation": "Fgaos ga"}}, "note": "Casaubon prints G where Crowley (and CAOSGA elsewhere) has C; keep as printed, note", "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "for", "readings": {"casaubon1659": {"word": "BAGLE", "dictated": "ELGAB", "pronunciation": "Ba gle"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "I am the Lord your God", "readings": {"casaubon1659": {"word": "ZIRENAIAD", "dictated": "DAIANERIZ", "pronunciation": "Zire nai ad"}}, "note": "Crowley prints this one Dee word as two", "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "which is", "readings": {"casaubon1659": {"word": "DSI", "dictated": "ISD", "pronunciation": "DSI"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "dictated": "ALIPADO", "pronunciation": "Od Api la"}}, "note": "Dee entry 39 is two words, Od Apila, glossed together", "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "liveth", "englishSplit": true, "readings": {"casaubon1659": {"word": "APILA", "dictated": "ALIPADO", "pronunciation": "(as above)"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "in the name", "readings": {"casaubon1659": {"word": "DOOAIP", "dictated": "PIAOOD", "pronunciation": "Do oa ip"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "of the Creatour", "readings": {"casaubon1659": {"word": "QAAL", "dictated": "LAAQ", "pronunciation": "Qa al"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "Move", "readings": {"casaubon1659": {"word": "ZACAR", "dictated": "RACAZ", "pronunciation": "Zacar."}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "And", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "dictated": "NARMAZDO", "pronunciation": "Od Zamran"}}, "note": "Dee entry 43 is two words, Od Zamran, glossed together; Dee's list adds \"[or appear]\"", "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "shew your selves", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZAMRAN", "dictated": "NARMAZDO", "pronunciation": "(as above)"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "As pleasant deliverers", "readings": {"casaubon1659": {"word": "OBELISONG", "dictated": "GNOSILEBO", "pronunciation": "Obelisong"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "that you may praise him", "readings": {"casaubon1659": {"word": "RESTIL", "dictated": "LITSER", "pronunciation": "Rest el."}}, "note": "caps print LITSER (read backwards RESTIL; checked at full size, p.109 n198); the pronunciation has \"Rest el.\" and Crowley resat-el. Word kept as the caps give it; the spike had RESTEL", "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "amongst", "readings": {"casaubon1659": {"word": "AAF", "dictated": "FAA", "pronunciation": "A af"}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]},
        {"english": "the sons of men", "readings": {"casaubon1659": {"word": "NORMOLAP", "dictated": "PALOMRON", "pronunciation": "Nor mo lap."}}, "sources": [{"work": "casaubon1659", "page": 109, "leaf": 198}]}
      ]
