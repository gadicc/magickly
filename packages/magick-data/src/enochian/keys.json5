        {"english": "comfort,", "englishSplit": true, "readings": {"casaubon1659": {"word": "BLIORA", "pronunciation": "Bli ó ra"}}, "note": "margin p.121: \"Cor. 1.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 121, "leaf": 210, "field": "enochian"}]},
        {"english": "conclude us", "readings": {"casaubon1659": {"word": "IAIAL", "pronunciation": "Ia ial."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 121, "leaf": 210, "field": "enochian"}]},
