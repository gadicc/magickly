    {
      "key": 11,
      "casaubonCall": 7,
      "dictated": "Saturday 14 May 1584, Cracow (\"Saturday, 14 Maii, Mane hora 6 Fere. + Cracoviae.\", p.118 n207); the English Thursday 5 July 1584 (p.189 n278, which names the 14 invocations \"received 14 Maii\").",
      "note": "\"This is the seventh\" after the Key (p.134 n223); English margin \"Δ 7 / 11\" (p.193 n282). Casaubon's print of the 14 May calls (pp.133-138) is damaged and out of order: lacunae printed as dots, and fragments of Keys 12, 13, 16 and 17 interleaved on pp.135-137 (the manuscript, Cotton Appendix XLVI, was damaged). The Enochian of Keys 14 and 15 and of the first 14 words of Key 16 is not printed at all; only a few of their words survive in the English pages' margins and in Dee's list of first words, p.200 n289 (12 July 1584).",
      "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "casaubon1659", "page": 80, "leaf": 173, "field": "enochian"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659", "equinox1912no8"], "covered": ["enochian", "english", "gd"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)"]},
      "rows": [
        {"english": "The mighty seat", "readings": {"casaubon1659": {"word": "OXIAYAL", "pronunciation": "Ox i Ay al."}, "equinox1912no8": {"word": "OXIAYALA"}}, "note": "The 'i' of the pronunciation carries a mark (accent or flaw). English line preceded by 'Another ——'.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "groaned,", "readings": {"casaubon1659": {"word": "HOLDO", "pronunciation": "Hol do."}, "equinox1912no8": {"word": "holado"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}, "equinox1912no8": {"word": "od"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "there were", "readings": {"casaubon1659": {"word": "ZIROM", "pronunciation": "Zir om.", "printed": ".IROM (damaged)"}, "equinox1912no8": {"word": "zodirome"}}, "note": "Damaged in the print. First letter of the capitals lost; pronunciation \"Zir om.\" gives ZIROM; Crowley agrees.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "5.", "readings": {"casaubon1659": {"word": "O", "pronunciation": "O."}, "equinox1912no8": {"word": "O"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "Thunders", "readings": {"casaubon1659": {"word": "CORAXO", "pronunciation": "Co ráx o."}, "equinox1912no8": {"word": "coraxo"}}, "note": "Pronunciation accented: \"ráx\".", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
