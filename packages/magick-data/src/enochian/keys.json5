        {"english": "Marble", "readings": {"casaubon1659": {"word": "PIDIAI", "pronunciation": "P i di a i."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
        {"english": "sleeves.", "readings": {"casaubon1659": {"word": "COLLAL", "pronunciation": "Col lal.", "printed": "COLLA.."}}, "note": "DAMAGED. Caps \"COLLA..\"; L from the pronunciation \"Col lal.\" (catchword p.129 \"COLLA\")", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "Happy is he", "readings": {"casaubon1659": {"word": "VLCININ", "pronunciation": "Vl ci nin."}}, "note": "Crowley breaks across his pp.116-117: \"Ul ci\" / \"ninu\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "on whom", "readings": {"casaubon1659": {"word": "ASOBAMA", "pronunciation": "A so bam."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "they frown not:", "readings": {"casaubon1659": {"word": "UCIM", "pronunciation": "U cim."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "For why?", "readings": {"casaubon1659": {"word": "BAGLE", "pronunciation": "Ba gle."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "the God of righteousnesse", "readings": {"casaubon1659": {"word": "IADBALTOH", "pronunciation": "I ad bal toh.", "printed": "IA.BALTOH"}}, "note": "DAMAGED. Caps \"IA.BALTOH\"; D from the pronunciation \"I ad bal toh.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "rejoyceth", "readings": {"casaubon1659": {"word": "CHIRLAN", "pronunciation": "Kir. / Chir lan."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "in them.", "readings": {"casaubon1659": {"word": "PAR", "pronunciation": "par."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "Come away,", "readings": {"casaubon1659": {"word": "NIISO", "pronunciation": "Ni i so.", "printed": "NII.."}}, "note": "DAMAGED. Caps \"NII..\"; S, O from the pronunciation \"Ni i so.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
        {"english": "And", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "note": "English line \"And not\" split over OD / IP", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
