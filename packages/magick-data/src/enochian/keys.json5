        {"english": "is", "readings": {"casaubon1659": {"word": "I", "pronunciation": "I ga.", "printed": "IGA (one entry)"}, "equinox1912no8": {"word": "i"}}, "note": "Dee writes IGA as one entry (\"I ga.\"); split as I + GA because the English gives \"is\" and \"31\" lines and Dee's margin p.193 reads \"31 ——— Ga.\"; Crowley \"i ga\".", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "31", "readings": {"casaubon1659": {"word": "GA", "pronunciation": "I ga.", "printed": "IGA (one entry)"}, "equinox1912no8": {"word": "ga"}}, "note": "See I: margin p.193 \"31 ——— Ga.\"", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
