    {
      "key": 9,
      "casaubonCall": 5,
      "dictated": "Saturday 14 May 1584, Cracow (\"Saturday, 14 Maii, Mane hora 6 Fere. Cracoviae\", p.118 n207); Keys 5-10 are the first to sixth Calls of that morning (p.129 \"This is the fifth of this day\", p.133 \"This is the sixth\")",
      "note": "p.130 \"This is the fifth of this day\"; p.191 margin \"Δ 5 / 9\" and \"The ninth.\" English given: Thursday 5 July 1584, Cracow (\"Thursday, Cracoviae, Julii 5. Mane, hora 8. fere\", p.189 n278) (p.191, second block, \"E.K. Now he hath opened again\").",
      "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 116, "leaf": 146, "field": "gd"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659", "equinox1912no8"], "covered": ["enochian", "english", "gd"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)", "the words Casaubon's print has damaged"]},
      "rows": [
