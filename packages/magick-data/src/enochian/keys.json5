        {"english": "on whom", "readings": {"casaubon1659": {"word": "ASOBAMA", "pronunciation": "A so bam."}, "equinox1912no8": {"word": "a sobame", "marker": "split"}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}]},
        {"english": "they frown not:", "readings": {"casaubon1659": {"word": "UCIM", "pronunciation": "U cim."}, "equinox1912no8": {"word": "ucime"}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}]},
        {"english": "For why?", "readings": {"casaubon1659": {"word": "BAGLE", "pronunciation": "Ba gle."}, "equinox1912no8": {"word": "Bajile"}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}]},
        {"english": "the God of righteousnesse", "readings": {"casaubon1659": {"word": "IADBALTOH", "pronunciation": "I ad bal toh.", "printed": "IA.BALTOH"}, "equinox1912no8": {"word": "IAD BALATOHE", "marker": "split"}}, "gdEnglish": "The Lord of Righteousness", "note": "Damaged in the print. The capitals \"IA.BALTOH\"; D from the pronunciation \"I ad bal toh.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}]},
        {"english": "rejoyceth", "readings": {"casaubon1659": {"word": "CHIRLAN", "pronunciation": "Kir. / Chir lan."}, "equinox1912no8": {"word": "cahirelanu"}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}]},
        {"english": "in them.", "readings": {"casaubon1659": {"word": "PAR", "pronunciation": "par."}, "equinox1912no8": {"word": "pare"}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}]},
        {"english": "Come away,", "readings": {"casaubon1659": {"word": "NIISO", "pronunciation": "Ni i so.", "printed": "NII.."}, "equinox1912no8": {"word": "NIISO"}}, "note": "Damaged in the print. The capitals \"NII..\"; S, O from the pronunciation \"Ni i so.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}, {"work": "equinox1912no8", "page": 117, "leaf": 147, "field": "gd"}]},
