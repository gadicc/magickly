        {"english": "binde up", "readings": {"casaubon1659": {"word": "ALLAR", "pronunciation": "Al lar."}, "equinox1912no8": {"word": "alalare"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "your girdles,", "readings": {"casaubon1659": {"word": "ATRAAH", "pronunciation": "A tra ah."}, "equinox1912no8": {"word": "ataraahe"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}, "equinox1912no8": {"word": "od"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "Visit us,", "readings": {"casaubon1659": {"word": "EF", "pronunciation": "Ef."}, "equinox1912no8": {"word": "ef"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "Bring down", "readings": {"casaubon1659": {"word": "DRIX", "pronunciation": "Drix."}, "equinox1912no8": {"word": "Darix"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "your train", "readings": {"casaubon1659": {"word": "FAFEN", "pronunciation": "Fa fen."}, "equinox1912no8": {"word": "fafenu"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "3663.", "readings": {"casaubon1659": {"word": "MIAN", "pronunciation": "Mi an."}, "equinox1912no8": {"word": "mianu"}}, "gdEnglish": "3663 (servitors)", "note": "English margin p.193 beside 3663: \"Mian.....\". Crowley italicises mianu.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "that", "readings": {"casaubon1659": {"word": "AR", "pronunciation": "Ar."}, "equinox1912no8": {"word": "ar"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "the Lord", "readings": {"casaubon1659": {"word": "ENAY", "pronunciation": "E nay."}, "equinox1912no8": {"word": "Enayo"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "may be magnified,", "readings": {"casaubon1659": {"word": "OVOF", "pronunciation": "O vof."}, "equinox1912no8": {"word": "ovof"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "whose", "readings": {"casaubon1659": {"word": "SOBA", "pronunciation": "So ba."}, "equinox1912no8": {"word": "Soba"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "name", "englishSplit": true, "readings": {"casaubon1659": {"word": "DOOAIN", "pronunciation": "Do ó a in."}, "equinox1912no8": {"word": "dooainu"}}, "note": "Pronunciation accented: \"ó\". English line \"whose name\" split over SOBA / DOOAIN.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "amongst you", "readings": {"casaubon1659": {"word": "AAI", "pronunciation": "A a i."}, "equinox1912no8": {"word": "aai"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "is", "englishSplit": true, "readings": {"casaubon1659": {"word": "I", "pronunciation": "I vonph.", "printed": "IVONPH (one entry)"}, "equinox1912no8": {"word": "i"}}, "note": "Dee writes IVONPH as one entry (\"I vonph.\"); split I + VONPH as Crowley does (\"i VONUPEHE\") and as the English line \"is wrath\" allows.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "wrath,", "englishSplit": true, "readings": {"casaubon1659": {"word": "VONPH", "pronunciation": "I vonph.", "printed": "IVONPH (one entry)"}, "equinox1912no8": {"word": "VONUPEHE"}}, "note": "English ends \"is wrath,&c.\" then \"...... Here must words in the end of the first Call, follow at Move, &c.\"; Dee: \"But this Call, it differeth a little expresly.\" English margin \"Δ 8 / 12\".", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "Move,", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZACAR", "pronunciation": "Za car."}, "equinox1912no8": {"word": "Zodacare"}}, "note": "Damaged in the print. Printed p.136 n225 with its capitals lost (a run of dots) except '...ICLE' and 'QAA', in the sequence 'Za car. / Go hus. / Zamran. / O do. / CICLE. / Qáa.', then 'That is a call. Δ. This is the eighth' (the eighth Call is Key 12). The fragment follows 'ILS. / Di alpert.' (Key 17's first words), part of the out-of-order damage on pp.135-137. English from Key 1 p.88 n181. The capitals are lost in the print.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "I say,", "readings": {"casaubon1659": {"word": "GOHUS", "pronunciation": "Go hus."}, "equinox1912no8": {"word": "gohusa"}}, "gdEnglish": "I say", "note": "Damaged in the print. Printed p.136 n225 with its capitals lost (a run of dots) except '...ICLE' and 'QAA', in the sequence 'Za car. / Go hus. / Zamran. / O do. / CICLE. / Qáa.', then 'That is a call. Δ. This is the eighth' (the eighth Call is Key 12). The fragment follows 'ILS. / Di alpert.' (Key 17's first words), part of the out-of-order damage on pp.135-137. Casaubon prints no English for GOHUS; \"I say\" is Crowley's (\"Move! I say, and shew yourselves!\", p.119). Dee: \"this Call, it differeth a little expresly\" (p.193). The capitals are lost in the print.", "sources": [{"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD"}, "equinox1912no8": {"word": "od"}}, "uncertain": true, "note": "Not in the p.136 fragment (which runs Zacar, Gohus, Zamran); kept from the first Call's ending (p.80 n173) and Crowley's 'gohusa, od Zodameranu'. Uncertain whether Dee's Key 12 had it.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 80, "leaf": 173, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "shew your selves,", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZAMRAN", "pronunciation": "Zamran."}, "equinox1912no8": {"word": "Zodameranu"}}, "note": "Damaged in the print. Printed p.136 n225 with its capitals lost (a run of dots) except '...ICLE' and 'QAA', in the sequence 'Za car. / Go hus. / Zamran. / O do. / CICLE. / Qáa.', then 'That is a call. Δ. This is the eighth' (the eighth Call is Key 12). The fragment follows 'ILS. / Di alpert.' (Key 17's first words), part of the out-of-order damage on pp.135-137. The capitals are lost in the print.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "open", "englishSplit": true, "readings": {"casaubon1659": {"word": "ODO", "pronunciation": "O do."}, "equinox1912no8": {"word": "odo"}}, "gdEnglish": "Unveil", "note": "Damaged in the print. Printed p.136 n225 with its capitals lost (a run of dots) except '...ICLE' and 'QAA', in the sequence 'Za car. / Go hus. / Zamran. / O do. / CICLE. / Qáa.', then 'That is a call. Δ. This is the eighth' (the eighth Call is Key 12). The fragment follows 'ILS. / Di alpert.' (Key 17's first words), part of the out-of-order damage on pp.135-137. The capitals are lost in the print.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "the mysteries", "englishSplit": true, "readings": {"casaubon1659": {"word": "CICLE", "pronunciation": "CICLE.", "printed": "...ICLE (damaged)"}, "equinox1912no8": {"word": "cicale"}}, "note": "Damaged in the print. Printed p.136 n225 with its capitals lost (a run of dots) except '...ICLE' and 'QAA', in the sequence 'Za car. / Go hus. / Zamran. / O do. / CICLE. / Qáa.', then 'That is a call. Δ. This is the eighth' (the eighth Call is Key 12). The fragment follows 'ILS. / Di alpert.' (Key 17's first words), part of the out-of-order damage on pp.135-137.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "of your Creation,", "englishSplit": true, "readings": {"casaubon1659": {"word": "QAA", "pronunciation": "Qáa."}, "equinox1912no8": {"word": "Qaa"}}, "note": "Printed p.136 n225 with its capitals lost (a run of dots) except '...ICLE' and 'QAA', in the sequence 'Za car. / Go hus. / Zamran. / O do. / CICLE. / Qáa.', then 'That is a call. Δ. This is the eighth' (the eighth Call is Key 12). The fragment follows 'ILS. / Di alpert.' (Key 17's first words), part of the out-of-order damage on pp.135-137.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "be friendly unto me;", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZORGE"}, "equinox1912no8": {"word": "Zodoreje"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "for", "englishSplit": true, "readings": {"casaubon1659": {"word": "LAP"}, "equinox1912no8": {"word": "lape"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "I am", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZIRDO"}, "equinox1912no8": {"word": "zodiredo"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "the servant", "englishSplit": true, "readings": {"casaubon1659": {"word": "NOCO"}, "equinox1912no8": {"word": "Noco"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "of the same your God,", "englishSplit": true, "readings": {"casaubon1659": {"word": "MAD"}, "equinox1912no8": {"word": "Mada"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "the true worshipper", "englishSplit": true, "readings": {"casaubon1659": {"word": "HOATH"}, "equinox1912no8": {"word": "hoathahe"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "of the Highest.", "englishSplit": true, "readings": {"casaubon1659": {"word": "IAIDA"}, "equinox1912no8": {"word": "IAIDA"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]}
      ]
    },
    {
      "key": 13,
      "casaubonCall": 9,
      "dictated": "Saturday 14 May 1584, Cracow (\"Saturday, 14 Maii, Mane hora 6 Fere. + Cracoviae.\", p.118 n207); the English Thursday 5 July 1584 (p.189 n278, which names the 14 invocations \"received 14 Maii\").",
      "note": "English margin \"Δ 9 / 13\" (p.193 n282). p.136's \"This is the eighth\" above NAPEAI closes the preceding fragment. Casaubon's print of the 14 May calls (pp.133-138) is damaged and out of order: lacunae printed as dots, and fragments of Keys 12, 13, 16 and 17 interleaved on pp.135-137 (the manuscript, Cotton Appendix XLVI, was damaged). The Enochian of Keys 14 and 15 and of the first 14 words of Key 16 is not printed at all; only a few of their words survive in the English pages' margins and in Dee's list of first words, p.200 n289 (12 July 1584).",
      "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "casaubon1659", "page": 80, "leaf": 173, "field": "enochian"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659", "equinox1912no8"], "covered": ["enochian", "english", "gd"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)", "Dee's Enochian for 2 words Casaubon's print lost: Crowley's form stands in, with no source in Dee's spelling"]},
      "rows": [
        {"english": "O you swords", "readings": {"casaubon1659": {"word": "NAPEAI", "pronunciation": "Na pe ai."}, "equinox1912no8": {"word": "NAPEAI"}}, "note": "Preceded on p.136 by \"Δ. This is the eighth\", which closes the previous (Key 12) fragment; Key 13 is Dee's ninth (English margin \"Δ 9 / 13\").", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "of the South", "readings": {"casaubon1659": {"word": "BABAGEN", "pronunciation": "jen. / B ba gen"}, "equinox1912no8": {"word": "Babajehe"}}, "note": "Pronunciation printed in two lines: \"jen.\" above \"B ba gen\".", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "which", "englishSplit": true, "readings": {"casaubon1659": {"word": "DS", "pronunciation": "Ds brin.", "printed": "DSBRIN (one entry)"}, "equinox1912no8": {"word": "das"}}, "note": "The capitals print DSBRIN as one; split DS + BRIN as Crowley (\"das berinu\") and as Dee does elsewhere (DS as its own word). English line \"which have\".", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "have", "englishSplit": true, "readings": {"casaubon1659": {"word": "BRIN", "pronunciation": "Ds brin.", "printed": "DSBRIN (one entry)"}, "equinox1912no8": {"word": "berinu"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "42", "readings": {"casaubon1659": {"word": "VX", "pronunciation": "V x."}, "equinox1912no8": {"word": "vax"}}, "note": "No capitals line: \"V x.\" is printed in the pronunciation column above \"O O Ao na.\"; English p.193 \"42 ——— Ux.\" Crowley italicises vax.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "eyes", "readings": {"casaubon1659": {"word": "OOAONA", "pronunciation": "O O Ao na."}, "equinox1912no8": {"word": "ooaona"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "to stir up", "readings": {"casaubon1659": {"word": "LRING", "pronunciation": "LRING."}, "equinox1912no8": {"word": "larinuji"}}, "note": "The pronunciation column repeats the capitals \"LRING.\"", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "the wrath", "readings": {"casaubon1659": {"word": "VONPH", "pronunciation": "Vonph."}, "equinox1912no8": {"word": "vonupehe"}}, "note": "Last word on p.136 for this Key; the Key continues on p.135 (pages printed out of order).", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "of sin,", "readings": {"casaubon1659": {"word": "DOALIM", "pronunciation": "Do a lim.", "printed": "...... (lost)"}, "equinox1912no8": {"word": "doalime"}}, "note": "Damaged in the print. The capitals lost (dots); pronunciation \"Do a lim.\" gives DOALIM; Crowley agrees.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "making", "readings": {"casaubon1659": {"word": "EOLIS", "pronunciation": "E o lis.", "printed": "..... (lost)"}, "equinox1912no8": {"word": "conisa"}}, "note": "Damaged in the print. The capitals lost; pronunciation \"E o lis.\" gives EOLIS. Crowley prints \"conisa\" here, not eolis.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "men", "englishSplit": true, "readings": {"casaubon1659": {"word": "OLLOG", "pronunciation": "Ol log.", "printed": "..... (lost)"}, "equinox1912no8": {"word": "olalogi"}}, "note": "Damaged in the print. The capitals lost; pronunciation \"Ol log.\" gives OLLOG. English line \"men drunken\" split over OLLOG / ORSBA.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "drunken", "englishSplit": true, "readings": {"casaubon1659": {"word": "ORSBA", "pronunciation": "Ors ba.", "printed": "..... (lost)"}, "equinox1912no8": {"word": "oresaha"}}, "note": "Damaged in the print. The capitals lost; pronunciation \"Ors ba.\" gives ORSBA. Crowley oresaha (h for b).", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "which", "englishSplit": true, "readings": {"casaubon1659": {"word": "DS", "pronunciation": "Ds chis.", "printed": "DSCHIS (one entry)"}, "equinox1912no8": {"word": "das"}}, "note": "The capitals print DSCHIS as one; split DS + CHIS as Crowley (\"das cahisa\"). English line \"which are\".", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "are", "englishSplit": true, "readings": {"casaubon1659": {"word": "CHIS", "pronunciation": "Ds chis.", "printed": "DSCHIS (one entry)"}, "equinox1912no8": {"word": "cahisa"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "empty.", "readings": {"casaubon1659": {"word": "AFFA", "pronunciation": "Af fa."}, "equinox1912no8": {"word": "afefa"}}, "note": "The first F of the capitals is poorly printed.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "Behold,", "readings": {"casaubon1659": {"word": "MICMA", "pronunciation": "Mic ma."}, "equinox1912no8": {"word": "Micama"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "the promise", "readings": {"casaubon1659": {"word": "ISRO", "pronunciation": "Is ro."}, "equinox1912no8": {"word": "isaro"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "of God", "readings": {"casaubon1659": {"word": "MAD", "pronunciation": "Mad."}, "equinox1912no8": {"word": "Mada"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}, "equinox1912no8": {"word": "od"}}, "note": "Catchword OD at the foot of p.135.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "his power,", "readings": {"casaubon1659": {"word": "LONSHITOX", "pronunciation": "Lon shi tox."}, "equinox1912no8": {"word": "Lonu-sahi-toxa"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "which", "readings": {"casaubon1659": {"word": "DS", "pronunciation": "ds."}, "equinox1912no8": {"word": "das"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "is called", "readings": {"casaubon1659": {"word": "JUMD", "pronunciation": "J umbd.", "printed": "JUMD."}, "equinox1912no8": {"word": "ivaumeda"}}, "note": "Printed JUMD (J for I), pronunciation \"J umbd.\"; the same word as Key 18's IVMD (\"I umd.\"). The next printed word, LUSDAN, belongs to Key 16.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 136, "leaf": 225, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "amongst you", "notInCasaubon": true, "readings": {"equinox1912no8": {"word": "aai"}}, "note": "Not in Casaubon's print: the Enochian stops at JUMD (p.136, followed by Key 16's LUSDAN). Crowley \"aai\"; Dee's word elsewhere for \"amongst you\" is AAI (Key 12, p.135), but the Dee reading here is unattested.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "A bitter sting.", "notInCasaubon": true, "readings": {"equinox1912no8": {"word": "Jirosabe"}}, "note": "Not in Casaubon's print (see the previous row). Crowley \"Jirosabe\". Dee reading unattested.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "Move", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZACAR"}, "equinox1912no8": {"word": "Zodacare"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 80, "leaf": 173, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "therefore", "englishSplit": true, "readings": {"casaubon1659": {"word": "CA"}, "equinox1912no8": {"marker": "absent"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here. CA ('therefore') is in Key 1's ending and in Dee's note p.193 n282 that the closing words are '14 last words ... Zacar e ca, od zamran ...'; Crowley prints no word here for this Key and his English has no 'therefore'.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 80, "leaf": 173, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD"}, "equinox1912no8": {"word": "od"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 80, "leaf": 173, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
        {"english": "shew your selves,", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZAMRAN"}, "equinox1912no8": {"word": "Zodameranu"}}, "gdEnglish": "Appear", "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 80, "leaf": 173, "field": "enochian"}, {"work": "equinox1912no8", "page": 120, "leaf": 150, "field": "gd"}]},
