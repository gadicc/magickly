    {
      "key": 7,
      "casaubonCall": 3,
      "dictated": "Saturday 14 May 1584, Cracow (\"Saturday, 14 Maii, Mane hora 6 Fere. Cracoviae\", p.118 n207); Keys 5-10 are the first to sixth Calls of that morning (p.129 \"This is the fifth of this day\", p.133 \"This is the sixth\")",
      "note": "not numbered at dictation (p.125 \"This is at an end\"); p.199: \"As this last, behold is the fourth, but with you the third. Δ It is the seventh: but the third of the fourteen\" English given: Wednesday 11 July 1584, \"a Meridie, hora 4\" (p.199 n288), by Ilemese standing in for Nalvage.",
      "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659", "equinox1912no8"], "covered": ["enochian", "english", "gd"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)"]},
      "rows": [
        {"english": "The East", "englishSplit": true, "readings": {"casaubon1659": {"word": "RAAS", "pronunciation": "Ra as."}, "equinox1912no8": {"word": "Ra-asa"}}, "note": "English line \"The East is a house of Virgins.\" (spoken by Ilemese before the columns) split over RAAS / ISALMAN / PARADIZ; margin \"3/7\" by the capitals", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "is a house", "englishSplit": true, "readings": {"casaubon1659": {"word": "ISALMAN", "pronunciation": "I Sal man."}, "equinox1912no8": {"word": "isalamanu"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "of Virgins.", "englishSplit": true, "readings": {"casaubon1659": {"word": "PARADIZ", "pronunciation": "Pa ra di zod.", "printed": "PARA..IZ"}, "equinox1912no8": {"word": "para-di-zoda"}}, "note": "Damaged in the print. The capitals \"PARA..IZ\"; D from the pronunciation \"Pa ra di zod.\"", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "Singing praises", "readings": {"casaubon1659": {"word": "OECRIMI", "pronunciation": "O écri mi."}, "equinox1912no8": {"word": "oe-cari-mi"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "amongst", "readings": {"casaubon1659": {"word": "AAO", "pronunciation": "A aó."}, "equinox1912no8": {"word": "aao"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
