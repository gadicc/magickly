        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}, "equinox1912no8": {"word": "od"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "cried with a loud voyce", "readings": {"casaubon1659": {"word": "BAHAL", "pronunciation": "Ba hal."}, "equinox1912no8": {"word": "bahala"}}, "gdEnglish": "cried aloud", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "Come away and they gathered themselves together and became", "englishSplit": true, "readings": {"casaubon1659": {"word": "NIISO", "pronunciation": "Ni i so."}, "equinox1912no8": {"word": "NIISO"}}, "gdEnglish": "Come away", "note": "Casaubon's English runs 'Come away / and / they gathered them- selves together / and / became / the house / of death'; his margin beside 'and became' reads 'There is no language for these words in the Call', so the words between 'Come away' and 'the house' have no Enochian and are kept on this row. Margin 'O.....' beside 'selves together'. Crowley: 'Come away from the House of Death! And they gathered themselves together and became (those) of whom it is measured'.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "the house", "englishSplit": true, "readings": {"casaubon1659": {"word": "SALMAN", "pronunciation": "Sal man."}, "equinox1912no8": {"word": "salamanu"}}, "note": "Printed p.134 (catchword SALMAN at the foot of p.133).", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "of death,", "readings": {"casaubon1659": {"word": "TELOCH", "pronunciation": "Te loch.", "printed": "TELOC.. (damaged)"}, "equinox1912no8": {"word": "telocahe"}}, "note": "Damaged in the print. The capitals end in two dots; pronunciation \"Te loch.\" with \"hotch.\" printed above it (a variant or correction of the ending). TELOCH; Crowley telocahe agrees.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "of whom", "readings": {"casaubon1659": {"word": "CASARMAN", "pronunciation": "Ca sár man."}, "equinox1912no8": {"word": "Casaremanu"}}, "note": "Pronunciation accented: \"sár\".", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
        {"english": "it is measured,", "readings": {"casaubon1659": {"word": "HOLQ", "pronunciation": "Hól q."}, "equinox1912no8": {"word": "hoel-qo"}}, "note": "Pronunciation accented: \"Hól\".", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
