        {"english": "of bloud:", "readings": {"casaubon1659": {"word": "CNILA", "pronunciation": "Cni la."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
        {"english": "Their heads", "readings": {"casaubon1659": {"word": "DAZIS", "pronunciation": "Daz is.", "printed": "DAZI."}}, "note": "DAMAGED. Caps \"DAZI.\"; S from the pronunciation \"Daz is.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
