        {"english": "into the East,", "readings": {"casaubon1659": {"word": "RAASY", "pronunciation": "Ra a sy."}, "equinox1912no8": {"word": "raasyo"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 133, "leaf": 222, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
