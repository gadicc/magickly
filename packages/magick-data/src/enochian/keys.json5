        {"english": "your viols.", "readings": {"casaubon1659": {"word": "OFAFAFE", "pronunciation": "O fa fa fe.", "printed": "O...AFE"}}, "note": "DAMAGED. Caps \"O...AFE\"; F, A, F from the pronunciation \"O fa fa fe.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}]},
