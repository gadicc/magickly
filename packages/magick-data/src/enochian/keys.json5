        {"english": "in their eyes", "readings": {"casaubon1659": {"word": "OOANOAN", "pronunciation": "O o A no an."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
