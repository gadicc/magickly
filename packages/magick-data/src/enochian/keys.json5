        {"english": "amongst", "readings": {"casaubon1659": {"word": "AAO", "pronunciation": "A aó."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}]},
        {"english": "the flames of first glorie,", "readings": {"casaubon1659": {"word": "IALPIRGAH", "pronunciation": "Yal. / I AL pir gah."}}, "note": "Crowley's second hyphen falls at a line end", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}]},
        {"english": "wherein", "readings": {"casaubon1659": {"word": "QUIIN", "pronunciation": "Qui in."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}]},
        {"english": "the Lord", "readings": {"casaubon1659": {"word": "ENAY", "pronunciation": "Enay."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}]},
        {"english": "hath opened his mouth", "readings": {"casaubon1659": {"word": "BUTMON", "pronunciation": "But mon."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 123, "leaf": 212, "field": "enochian"}]},
        {"english": "they are become", "readings": {"casaubon1659": {"word": "INOAS", "pronunciation": "In ó as."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "Twenty eight", "readings": {"casaubon1659": {"word": "NI", "pronunciation": "Ni."}}, "note": "beside \"Twenty eight\" p.199: \"Ile.... Ni, That you have not.\"", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "living dwellings,", "readings": {"casaubon1659": {"word": "PARADIAL", "pronunciation": "Pa ra di al."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "in whom", "readings": {"casaubon1659": {"word": "CASARMG", "pronunciation": "Ca sármg. The g as dg ármg."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "the strength of man", "readings": {"casaubon1659": {"word": "VGEAR", "pronunciation": "V gé ar."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "rejoyceth.", "readings": {"casaubon1659": {"word": "CHIRLAN", "pronunciation": "Kir. / Chir lan."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "they are apparail'd", "readings": {"casaubon1659": {"word": "ZONAC", "pronunciation": "Zo nac.", "printed": "ZONA.."}}, "note": "DAMAGED. Caps \"ZONA..\"; C from the pronunciation \"Zo nac.\"", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "with ornaments so bright", "readings": {"casaubon1659": {"word": "LUCIFTIAN", "pronunciation": "Lu cif ti an."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "such as", "readings": {"casaubon1659": {"word": "CORSTA", "pronunciation": "Cors ta."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "work wonders", "readings": {"casaubon1659": {"word": "VAULZIRN", "pronunciation": "Vául zirn."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "on all creatures,", "readings": {"casaubon1659": {"word": "TOLHAMI", "pronunciation": "Tol há mi."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "whose", "readings": {"casaubon1659": {"word": "SOBA", "pronunciation": "Soba."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "Kingdoms", "readings": {"casaubon1659": {"word": "LONDOH", "pronunciation": "Lon dóh."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od mi am, or Od Nuám.", "printed": "ODMIAM"}}, "note": "caps entry ODMIAM is OD + MIAM", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "continuance", "englishSplit": true, "readings": {"casaubon1659": {"word": "MIAM", "pronunciation": "(as above)", "printed": "ODMIAM"}}, "note": "the pronunciation gives the alternative \"Od Nuám\"; Crowley follows it (nuame); the second ODMIAM below he prints miame", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "are as the third", "readings": {"casaubon1659": {"word": "CHISTAD", "pronunciation": "Kis / Chis tad."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "pronunciation": "O des.", "printed": "ODES"}}, "note": "caps entry ODES is OD + ES; Crowley \"o Desa\" carries the D of OD into ES (an overlap, the GD form held here)", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "fourth", "englishSplit": true, "readings": {"casaubon1659": {"word": "ES", "pronunciation": "(as above)", "printed": "ODES"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "strong Towers", "readings": {"casaubon1659": {"word": "VMADEA", "pronunciation": "V má de a.", "printed": "VM:DEA"}}, "note": "DAMAGED. A colon prints where a letter stands (\"VM:DEA\"); A from the pronunciation \"V má de a.\"", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "places of comfort.", "readings": {"casaubon1659": {"word": "PIBLIAR", "pronunciation": "Pib li ar."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "The seat of mercy", "readings": {"casaubon1659": {"word": "OTHILRIT", "pronunciation": "O thil rit."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od mi am. / Kol.", "printed": "ODMIAM"}}, "note": "caps entry ODMIAM is OD + MIAM; English line \"and continuance.\" split", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "continuance.", "englishSplit": true, "readings": {"casaubon1659": {"word": "MIAM", "pronunciation": "(as above)", "printed": "ODMIAM"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "O you servants", "englishSplit": true, "readings": {"casaubon1659": {"word": "CNOQUOL", "pronunciation": "Cno quol."}}, "note": "English line \"O you servants of mercy.\" split over CNOQUOL / RIT", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "of mercy.", "englishSplit": true, "readings": {"casaubon1659": {"word": "RIT", "pronunciation": "Rit."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "Move,", "readings": {"casaubon1659": {"word": "ZACAR", "pronunciation": "Za car."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "appear,", "readings": {"casaubon1659": {"word": "ZAMRAN", "pronunciation": "Zam ran."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}]},
        {"english": "sing praises", "readings": {"casaubon1659": {"word": "OECRIMI", "pronunciation": "O é crimi."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "unto the Creator,", "readings": {"casaubon1659": {"word": "QADAH", "pronunciation": "Qá dah.", "printed": "QADA:"}}, "note": "DAMAGED. A colon prints for the last letter (\"QADA:\"); H from the pronunciation \"Qá dah.\"; Crowley's first hyphen falls at a line end", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "be mighty", "readings": {"casaubon1659": {"word": "OMICAOLZ", "pronunciation": "O mi ca ol zod."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "amongst us,", "readings": {"casaubon1659": {"word": "AAIOM", "pronunciation": "A A I om."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "for", "readings": {"casaubon1659": {"word": "BAGLE", "pronunciation": "Ba gle."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "unto this remembrance", "readings": {"casaubon1659": {"word": "PAPNOR", "pronunciation": "Pap nor."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "is given", "readings": {"casaubon1659": {"word": "IDLUGAM", "pronunciation": "Id lú gam."}}, "note": "Crowley's hyphen falls at a line end", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "power,", "readings": {"casaubon1659": {"word": "LONSHI", "pronunciation": "Lon shi."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "our strength", "readings": {"casaubon1659": {"word": "VMPLIF", "pronunciation": "Vmp lif."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "waxeth strong", "readings": {"casaubon1659": {"word": "VGEGI", "pronunciation": "V Ge gi."}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "in our comforter.", "readings": {"casaubon1659": {"word": "BIGLIAD", "pronunciation": "Bigli ad.", "printed": "BIGLIA.."}}, "note": "DAMAGED. Caps \"BIGLIA..\" (first letter also worn); D from the pronunciation \"Bigli ad.\"; then \"Nal. This is at an end.\"", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]}
      ]
    },
    {
      "key": 8,
      "casaubonCall": 4,
      "dictated": "Saturday 14 May 1584, Cracow (\"Saturday, 14 Maii, Mane hora 6 Fere. Cracoviae\", p.118 n207); Keys 5-10 are the first to sixth Calls of that morning (p.129 \"This is the fifth of this day\", p.133 \"This is the sixth\")",
      "note": "not numbered at dictation (p.127 \"This is the end of that\"); p.192 margin \"Δ 4 / 8\" English given: Thursday 5 July 1584, Cracow (\"Thursday, Cracoviae, Julii 5. Mane, hora 8. fere\", p.189 n278) (p.192, no new date heading between p.189 and p.192).",
      "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659"], "covered": ["enochian", "english"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)", "the words Casaubon's print has damaged", "the Golden Dawn's reading"]},
      "rows": [
        {"english": "The midday the first,", "readings": {"casaubon1659": {"word": "BAZMELO", "pronunciation": "Baz me lo."}}, "note": "a small mark (\"¾\"?) in the margin before the caps", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "is as", "readings": {"casaubon1659": {"word": "ITA", "pronunciation": "I ta"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "the third Heaven", "readings": {"casaubon1659": {"word": "PIRIPSON", "pronunciation": "..rip son.", "printed": "PIRIPS▪N (blotted)"}}, "note": "DAMAGED. A blot covers the last letters of the caps and the first of the pronunciation; O, N from the pronunciation \"..rip son.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "made", "readings": {"casaubon1659": {"word": "OLN", "pronunciation": "Oln."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "of Hiacinct pillars", "readings": {"casaubon1659": {"word": "NAZAVABH", "pronunciation": "Na za vábh."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "26.", "readings": {"casaubon1659": {"word": "OX", "pronunciation": "Ox."}}, "note": "beside \"26.\" p.192: \"Nal ... Ox: And that you have not.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "In whom", "readings": {"casaubon1659": {"word": "CASARMG", "pronunciation": "Casarmg."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "the Elders", "readings": {"casaubon1659": {"word": "VRAN", "pronunciation": "V rán.", "printed": "G or V RAN"}}, "uncertain": true, "note": "caps print \"G or V RAN\"; the pronunciation \"V rán.\" and Crowley (varanu) have V. Uncertain first letter", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "are", "readings": {"casaubon1659": {"word": "CHIS", "pronunciation": "Chis."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "become strange,", "readings": {"casaubon1659": {"word": "VGEG", "pronunciation": "V geg."}}, "note": "Casaubon prints \"strange\" (checked at full size); Crowley and the old the 2023 text have \"strong\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "which I have prepared", "readings": {"casaubon1659": {"word": "DSABRAMG", "pronunciation": "Dsabramg. [g not as dg.]", "printed": "..SABRAMG"}}, "note": "DAMAGED. Caps \"..SABRAMG\"; D from the pronunciation \"Dsabramg.\"; English two lines \"which\" / \"I have prepared\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "for my own righteousnesse,", "readings": {"casaubon1659": {"word": "BALTOHA", "pronunciation": "Bal to ha."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}]},
        {"english": "saith the Lord,", "readings": {"casaubon1659": {"word": "GOHOIAD", "pronunciation": "Go hó i ad."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "whose long continuance", "readings": {"casaubon1659": {"word": "SOLAMIAN", "pronunciation": "So lá mi an."}}, "note": "Crowley \"Soba miame\" for Casaubon's SOLAMIAN", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "shall be", "readings": {"casaubon1659": {"word": "TRIAN", "pronunciation": "Tri an."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "as Buckles", "readings": {"casaubon1659": {"word": "TALOLCIS", "pronunciation": "Ta lól cis or sis."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "to the stooping Dragons,", "readings": {"casaubon1659": {"word": "ABAIUONIN", "pronunciation": "A ba i uo nin."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "O D."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "like unto the Harvest", "readings": {"casaubon1659": {"word": "AZIAGIAR", "pronunciation": "A zi á gi er."}}, "note": "margin: \"He putteth his feet on all these letters.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "of a Widow.", "readings": {"casaubon1659": {"word": "RIOR", "pronunciation": "Rior."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "How many are there", "readings": {"casaubon1659": {"word": "IRGILCHISDA", "pronunciation": "Ir gil chis da."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "which remain", "readings": {"casaubon1659": {"word": "DSPAAOX", "pronunciation": "Dspá a ox.", "printed": "DSPAAOX."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "in the glory", "readings": {"casaubon1659": {"word": "BUFD", "pronunciation": "Bufd."}}, "note": "caps print a roman F (checked at full size); Crowley busada; perhaps a long s misread as f in 1659. Kept as printed", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "of the earth,", "readings": {"casaubon1659": {"word": "CAOSGO", "pronunciation": "Ca, or Ka osgo."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "which are,", "readings": {"casaubon1659": {"word": "DSCHIS", "pronunciation": "Ds chis."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Odi pu ran.", "printed": "ODIPURAN"}}, "note": "caps entry ODIPURAN is OD + IPURAN", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "shall not see", "englishSplit": true, "readings": {"casaubon1659": {"word": "IPURAN", "pronunciation": "(as above)", "printed": "ODIPURAN"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "death", "englishSplit": true, "readings": {"casaubon1659": {"word": "TELOAH", "pronunciation": "Té lo ah."}}, "note": "English line \"death untill\" split over TELOAH / CACRG", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "untill", "englishSplit": true, "readings": {"casaubon1659": {"word": "CACRG", "pronunciation": "Ca curg."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "this house", "readings": {"casaubon1659": {"word": "OISALMAN", "pronunciation": "O i sal man."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "fall,", "readings": {"casaubon1659": {"word": "LONCHO", "pronunciation": "Lon cho, or ko."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "the Dragon", "readings": {"casaubon1659": {"word": "VOUINA", "pronunciation": "Vo ui na."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "sink.", "readings": {"casaubon1659": {"word": "CARBAF", "pronunciation": "Car baf."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "Come away.", "readings": {"casaubon1659": {"word": "NIISO", "pronunciation": "Ni i so."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "For,", "readings": {"casaubon1659": {"word": "BAGLE", "pronunciation": "Ba gle."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "the Thunders", "readings": {"casaubon1659": {"word": "AUAUAGO", "pronunciation": "A uá uago."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "have spoken:", "readings": {"casaubon1659": {"word": "GOHON", "pronunciation": "Go hón."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "Come away.", "readings": {"casaubon1659": {"word": "NIISO", "pronunciation": "Ni i so."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 126, "leaf": 215, "field": "enochian"}]},
        {"english": "For,", "readings": {"casaubon1659": {"word": "BAGLE", "pronunciation": "Ba gle."}}, "note": "then \"Δ. He casteth fire on E.K.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "the Crowns", "readings": {"casaubon1659": {"word": "MOMAO", "pronunciation": "Mo ma o."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "of the Temple,", "readings": {"casaubon1659": {"word": "SIAION", "pronunciation": "Si a i on."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "the Coat", "readings": {"casaubon1659": {"word": "MABZA", "pronunciation": "Mab za."}}, "note": "\"He maketh a cursie, he sayeth Mabza again.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "of him, that is, was, and shall be Crowned", "readings": {"casaubon1659": {"word": "IADOIASMOMAR", "pronunciation": "Iad o i as mo mar."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "are divided.", "readings": {"casaubon1659": {"word": "POILP", "pronunciation": "Poilp, one syllable."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "Come", "readings": {"casaubon1659": {"word": "NIIS", "pronunciation": "Ni is, small sound of i."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "appear", "readings": {"casaubon1659": {"word": "ZAMRAN", "pronunciation": "Zam ran."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "to the terrour", "readings": {"casaubon1659": {"word": "CIAOFI", "pronunciation": "C i A O fi."}}, "note": "Casaubon F, Crowley s (long s and f again)", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "of the earth", "readings": {"casaubon1659": {"word": "CAOSGO", "pronunciation": "Ka. / Ca os go."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "O D."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "to our comfort,", "readings": {"casaubon1659": {"word": "BLIORS", "pronunciation": "Bli ors.", "printed": "BLI....S"}}, "note": "DAMAGED. Caps \"BLI....S\"; O, R from the pronunciation \"Bli ors.\"", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "O D."}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "of such", "readings": {"casaubon1659": {"word": "CORSI", "pronunciation": "Cor si.", "printed": "COR...."}}, "uncertain": true, "note": "DAMAGED. Caps \"COR....\"; S, I from the pronunciation \"Cor si.\" (an italic long s, which can be confused with f). Uncertain", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "as", "readings": {"casaubon1659": {"word": "TA", "pronunciation": "Ta"}}, "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "are prepared", "readings": {"casaubon1659": {"word": "ABRAMIG", "pronunciation": "A bra mig."}}, "note": "then \"This is the end of that.\" No common ending follows", "sources": [{"work": "casaubon1659", "page": 192, "leaf": 281, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]}
      ]
    },
    {
      "key": 9,
      "casaubonCall": 5,
      "dictated": "Saturday 14 May 1584, Cracow (\"Saturday, 14 Maii, Mane hora 6 Fere. Cracoviae\", p.118 n207); Keys 5-10 are the first to sixth Calls of that morning (p.129 \"This is the fifth of this day\", p.133 \"This is the sixth\")",
      "note": "p.130 \"This is the fifth of this day\"; p.191 margin \"Δ 5 / 9\" and \"The ninth.\" English given: Thursday 5 July 1584, Cracow (\"Thursday, Cracoviae, Julii 5. Mane, hora 8. fere\", p.189 n278) (p.191, second block, \"E.K. Now he hath opened again\").",
      "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}, {"work": "casaubon1659", "page": 130, "leaf": 219, "field": "enochian"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659"], "covered": ["enochian", "english"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)", "the words Casaubon's print has damaged", "the Golden Dawn's reading"]},
      "rows": [
        {"english": "A mighty", "readings": {"casaubon1659": {"word": "MICAOLI", "pronunciation": "Mi ca o li."}}, "note": "Gabriel before it: \"Who is to be compared to our God?\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "Guard", "readings": {"casaubon1659": {"word": "BRANSG", "pronunciation": "Bransg."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "of fires,", "readings": {"casaubon1659": {"word": "PURGEL", "pronunciation": "Pur gel.", "printed": "P..GEL"}}, "note": "DAMAGED. Caps \"P..GEL\"; U, R from the pronunciation \"Pur gel.\"; English \"fi'es\" with the r worn", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "with two edged swords", "readings": {"casaubon1659": {"word": "NAPTA", "pronunciation": "Nap ta."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "flaming,", "readings": {"casaubon1659": {"word": "IALPOR", "pronunciation": "Yal / I AL por."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 127, "leaf": 216, "field": "enochian"}]},
        {"english": "which have", "readings": {"casaubon1659": {"word": "DSBRIN", "pronunciation": "Ds brin."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "the Viols", "readings": {"casaubon1659": {"word": "EFAFAFE", "pronunciation": "E fa fa fe.", "printed": "...FAFE"}}, "note": "DAMAGED. Caps \"...FAFE\"; E, F, A from the pronunciation \"E fa fa fe.\"; the margin spells the word downwards E F A F A F I beside \"..otia thus\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "eight", "readings": {"casaubon1659": {"word": "P"}}, "note": "not in the caps column; inserted by the instruction at the foot of p.128. p.191 beside \"the Viols eight\": \"Nal.... That is P. you have not mark the mysterie.\" Δ margin p.128: \"This word is the 25 word backward.\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "of wrath", "readings": {"casaubon1659": {"word": "VONPHO", "pronunciation": "Von pho."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "for two times", "readings": {"casaubon1659": {"word": "OLANI", "pronunciation": "O L a ni.", "printed": "O'LANI"}}, "note": "a raised mark between O and L in the caps", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od.", "printed": "O·D"}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "a half,", "readings": {"casaubon1659": {"word": "OBZA", "pronunciation": "Ob za."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
