    {
      "key": 5,
      "casaubonCall": 1,
      "dictated": "Saturday 14 May 1584, Cracow (\"Saturday, 14 Maii, Mane hora 6 Fere. Cracoviae\", p.118 n207); Keys 5-10 are the first to sixth Calls of that morning (p.129 \"This is the fifth of this day\", p.133 \"This is the sixth\")",
      "note": "\"That is one Call.\" (p.121); p.191 margin \"Δ 5 / 1\"; p.190 \"Sapah It is the fifth, for 4 being Englished\" English given: Thursday 5 July 1584, Cracow (\"Thursday, Cracoviae, Julii 5. Mane, hora 8. fere\", p.189 n278); the English of this Call is p.191 (Δ there: \"I understand this to be the English of the fifth Call; and that before of the sixth\").",
      "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}, {"work": "casaubon1659", "page": 120, "leaf": 209, "field": "enochian"}, {"work": "casaubon1659", "page": 121, "leaf": 210, "field": "enochian"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659"], "covered": ["enochian", "english"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)", "the words Casaubon's print has damaged", "the Golden Dawn's reading"]},
      "rows": [
        {"english": "The mighty sounds", "readings": {"casaubon1659": {"word": "SAPAH", "pronunciation": "Sa pah. / Sa pah."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "have entered", "readings": {"casaubon1659": {"word": "ZIMII", "pronunciation": "Zi mii."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "into the third Angle,", "readings": {"casaubon1659": {"word": "DUIV", "pronunciation": "Du iv."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "note": "a damaged margin note beside this line begins \"O D.\" (the rest lost: \"...no / ...reth / ...& / ...ione / ...ded.\")", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "are become", "readings": {"casaubon1659": {"word": "NOAS", "pronunciation": "Noas."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "as Olives", "readings": {"casaubon1659": {"word": "TAQANIS", "pronunciation": "Ta qu a nis."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "in the Olive Mount,", "readings": {"casaubon1659": {"word": "ADROCH", "pronunciation": "as otch / Ad roch."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "looking with gladnesse", "readings": {"casaubon1659": {"word": "DORPHAL", "pronunciation": "Dorphal."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "upon the earth,", "readings": {"casaubon1659": {"word": "CAOSG", "pronunciation": "Ca ósg"}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "dwelling in the brightnesse", "readings": {"casaubon1659": {"word": "FAONTS", "pronunciation": "Fa onts."}}, "note": "English printed \"* dwelling in the brightnesse\", the asterisk keyed to a margin note repeating the phrase", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "of the Heavens", "readings": {"casaubon1659": {"word": "PIRIPSOL", "pronunciation": "Pir ip sol."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
        {"english": "as continual comforters,", "readings": {"casaubon1659": {"word": "TABLIOR", "pronunciation": "Táblior."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 119, "leaf": 208, "field": "enochian"}]},
