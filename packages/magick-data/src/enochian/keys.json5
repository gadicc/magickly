        {"english": "in the midst", "readings": {"casaubon1659": {"word": "NOTHOA", "dictated": "AOHTON", "pronunciation": "Nothoa. Here is a point before the word. A point."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "of my vestures", "readings": {"casaubon1659": {"word": "ZIMZ", "dictated": "ZMIZ", "pronunciation": "Zimz. A point."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "And", "readings": {"casaubon1659": {"word": "OD", "dictated": "DO", "pronunciation": "As before OD."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
