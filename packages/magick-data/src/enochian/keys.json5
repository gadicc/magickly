        {"english": "obedience", "englishSplit": true, "readings": {"casaubon1659": {"word": "ADNA", "dictated": "ANDA", "pronunciation": "Call it ADNA."}}, "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "and faith", "englishSplit": true, "readings": {"casaubon1659": {"word": "GONO", "dictated": "ONOG", "pronunciation": "Call it Gono."}}, "note": "no OD printed before GONO (the 2023 text has OD \"and\"); a DS dictated after it was struck: \"This was corrected on Monday following, too much\"", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "to him", "englishSplit": true, "readings": {"casaubon1659": {"word": "IADPIL", "dictated": "LIPDAI", "pronunciation": "Call it IADPIL accent ad."}}, "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "that", "englishSplit": true, "readings": {"casaubon1659": {"word": "DS", "dictated": "SD", "pronunciation": "DS."}}, "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "liveth", "englishSplit": true, "readings": {"casaubon1659": {"word": "HOM", "dictated": "MOH", "pronunciation": "HOM."}}, "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "and triumpheth", "englishSplit": true, "readings": {"casaubon1659": {"word": "TOH", "dictated": "HOT", "pronunciation": "TOH. There is a point, shewing a stroke, called Virgula."}}, "note": "no OD printed between HOM and TOH (the 2023 text has OD \"and\")", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "whose", "englishSplit": true, "readings": {"casaubon1659": {"word": "SOBA", "dictated": "ABOS", "pronunciation": "SOBA"}}, "note": "replaces three words first dictated after IPAM (DO/OD, HOTLAB \"Call it BALTOH\", PAIP \"Call it Piap\"), which Nalvage then declared false: \"I am deceived from Ipam. O D the next is false, and so are the rest ... ABOS SOBA\"", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "beginning", "englishSplit": true, "unspoken": true, "readings": {}, "uncertain": true, "note": "not printed: after MAPI (57) Nalvage \"hummed twice, signifying two words more, which were not to be pronounced till they were read in practise\". Two rows hold those two words; their places and English (\"beginning\", \"nor\") are ours, from the running English \"whose beginning is not, nor end can not be\"", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "is not,", "englishSplit": true, "readings": {"casaubon1659": {"word": "IPAM", "dictated": "MAPI", "pronunciation": "(none; \"E.K. It seemeth to be an e.\")"}}, "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "nor", "englishSplit": true, "unspoken": true, "readings": {}, "uncertain": true, "note": "the second of the two hummed, unprinted words; see the row before IPAM", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}]},
        {"english": "end", "englishSplit": true, "readings": {"casaubon1659": {"word": "UL", "dictated": "LU", "pronunciation": "Call it UL. Δ, With such sound to U. as we pronounce yew, whereof bows are made."}}, "note": "LU is the dictated (reversed) form; Nalvage's forward reading is UL. Crowley prints \"lu\"", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "can not be", "englishSplit": true, "readings": {"casaubon1659": {"word": "IPAMIS", "dictated": "SIMAPI", "pronunciation": "Pronounce it IPAMIS. Make a point at S, the A pronounced short."}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "which", "englishSplit": true, "readings": {"casaubon1659": {"word": "DS", "dictated": "SD", "pronunciation": "It is the uppermost of ... Call it DS."}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "shineth", "englishSplit": true, "readings": {"casaubon1659": {"word": "LOHOLO", "dictated": "OLOHOL", "pronunciation": "Call it Loholo. Long, the first syllable accented."}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "as a flame", "englishSplit": true, "readings": {"casaubon1659": {"word": "VEP", "dictated": "PEV", "pronunciation": "It is called Vep. Make a point there. Δ. A full point? Nal. No, no, a stroke."}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "in the midst", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZOMDV", "dictated": "XVDMOZ", "pronunciation": "Call it Zome."}}, "uncertain": true, "note": "caps print XVDMOZ: the first letter dictated was doubtful (\"it seemed to E.K. to be an X ... At length he said it was V\"), so the print shows both X and V. Read forward with V: ZOMDV. The 2023 text and Crowley (\"zodomeda\") have no V", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "of your Palace,", "englishSplit": true, "readings": {"casaubon1659": {"word": "POAMAL", "dictated": "LAMAOP", "pronunciation": "Poamal Od, put out the S."}}, "note": "Dee entry 64 is two words: dictated \"DOS\" (margin \"Also T\") then LAMAOP; \"Make it two words ... It may be all one word with S. or T. ... Make a point between Poamal and Od\"", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "dictated": "DOS", "pronunciation": "(as above)"}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "raigneth", "englishSplit": true, "readings": {"casaubon1659": {"word": "BOGPA", "dictated": "APGOB", "pronunciation": "Call it Bogpa."}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "amongst you", "englishSplit": true, "readings": {"casaubon1659": {"word": "AAI", "dictated": "IAA", "pronunciation": "AAI. The first A may be an A an O or an E. Those are two words."}}, "note": "dictated as letters I, A, A; \"Those are two words\" is printed under them", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "as", "englishSplit": true, "readings": {"casaubon1659": {"word": "TA", "dictated": "AT", "pronunciation": "TA."}}, "note": "dictated as letters A, T", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "the Ballance", "englishSplit": true, "readings": {"casaubon1659": {"word": "PIAP", "dictated": "PAIP", "pronunciation": "PIAP."}}, "note": "dictated as letters P, A, I, P (Saturday 14 April: \"Read backward, letter without number\")", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}]},
        {"english": "of righteousnesse", "englishSplit": true, "readings": {"casaubon1659": {"word": "PIAMOL", "dictated": "LOMAIP", "pronunciation": "Call it Piamo el. It is Piatel Baltale to be founded."}}, "note": "dictated letter by letter in two columns: right L, O, M, A, I, P (PIAMOL); left E, L, O, T, L, A, B (BALTOLE), with \"this O must be sounded as A\" and \"T must be instead of M\"; margin \"Aversed\". The forward reading \"Piamo el\" is clear. Crowley prints \"Piamo-el\" across a line break", "sources": [{"work": "casaubon1659", "page": 81, "leaf": 174}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "dictated": "DO", "pronunciation": "call it O D. [Δ. drawing the O long.]"}}, "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}]},
        {"english": "truth.", "englishSplit": true, "readings": {"casaubon1659": {"word": "VOOAN", "dictated": "NAOOV", "pronunciation": "It is Vooan. It may be founded Vaoan."}}, "note": "caps VOOAN; beside it: \"Vooan is spoken with them that fall, but Vaoan with them that are, and are glorified\" (the 2023 text VAOAN)", "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}]},
        {"english": "Move", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZACAR", "dictated": "RACAZ", "pronunciation": "E must come after R: but without number, and so, it is Zacare. Call it Zacar."}}, "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}]},
        {"english": "therefore", "englishSplit": true, "readings": {"casaubon1659": {"word": "CA", "dictated": "AC", "pronunciation": "Call it C A, [Δ. two syllables.]"}}, "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "dictated": "TO", "pronunciation": "Call it O D ....... or O T."}}, "note": "first letter dictated: \"This may be T or D\"", "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}]},
        {"english": "shew your selves,", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZAMRAN", "dictated": "NARNAZ", "pronunciation": "Zamran. Call it Zanran."}}, "note": "the fourth letter was dictated N and \"be corrected it M\"; of the fifth \"This A may be an A or an O\"; \"I give it faster unto you, than I received it\"", "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}]},
        {"english": "open", "englishSplit": true, "readings": {"casaubon1659": {"word": "ODO", "dictated": "ODO", "pronunciation": "Call it O D O."}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}]},
        {"english": "the mysteries", "englishSplit": true, "readings": {"casaubon1659": {"word": "CICLE", "dictated": "ELCIC", "pronunciation": "Call it Cicle."}}, "note": "printed without a number (QAA is 79, ODO 76; the right margin has \"7877\"); \"That C. is called C Minor\"", "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}]},
        {"english": "of your Creation,", "englishSplit": true, "readings": {"casaubon1659": {"word": "QAA", "dictated": "AAQ", "pronunciation": "Call it Q A A. [Three syllables with accent on the last A.]"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}]},
