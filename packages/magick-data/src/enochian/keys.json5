        {"english": "wings", "readings": {"casaubon1659": {"word": "VPAAH", "pronunciation": "V pa ah."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
