        {"english": "of your Creation,", "englishSplit": true, "readings": {"casaubon1659": {"word": "QAA"}, "equinox1912no8": {"word": "Qaa"}}, "note": "Printed once, with Key 1 (pp. 79-80, English p. 88); repeated here.", "sources": [{"work": "casaubon1659", "page": 88, "leaf": 181, "field": "english"}, {"work": "casaubon1659", "page": 79, "leaf": 172, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
