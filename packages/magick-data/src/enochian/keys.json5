        {"english": "with admiration", "readings": {"casaubon1659": {"word": "GRSAM", "dictated": "MASRG", "pronunciation": "GRSAM; a stop at M. Δ as Gursam."}}, "sources": [{"work": "casaubon1659", "page": 85, "leaf": 178}]},
