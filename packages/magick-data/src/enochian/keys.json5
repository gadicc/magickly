        {"english": "of my hands", "readings": {"casaubon1659": {"word": "ZIEN", "dictated": "NEIZ", "pronunciation": "ZIEN here a point."}}, "sources": [{"work": "casaubon1659", "page": 85, "leaf": 178}]},
