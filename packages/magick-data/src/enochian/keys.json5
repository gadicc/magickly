        {"english": "I am", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZIRDO", "dictated": "ODRIZ", "pronunciation": "Call it Zirdo."}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}]},
        {"english": "the servant", "englishSplit": true, "readings": {"casaubon1659": {"word": "NOCO", "dictated": "OCON", "pronunciation": "Call it Noco."}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}]},
        {"english": "of the same your God,", "englishSplit": true, "readings": {"casaubon1659": {"word": "MAD", "dictated": "DAM", "pronunciation": "Call it Mad."}}, "note": "first letter line printed \"225.\" with the letter D on the next line (\"The same number repeated\")", "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}]},
