        {"english": "of an harlot", "readings": {"casaubon1659": {"word": "ABABALOND", "pronunciation": "A bá ba lond."}, "equinox1912no8": {"word": "a babalanuda", "marker": "split"}}, "note": "Crowley prints two words \"a babalanuda\"", "sources": [{"work": "casaubon1659", "page": 207, "leaf": 296}, {"work": "equinox1912no8", "page": 126, "leaf": 156, "field": "gd"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "pronunciation": "gt, or dgt. / Od fa orgt.", "printed": "ODFAORGT"}, "equinox1912no8": {"word": "od"}}, "note": "Dee entry ODFAORGT is two words, glossed together \"and the dwelling place\": split; \"gt, or dgt.\" printed above the pronunciation", "sources": [{"work": "casaubon1659", "page": 207, "leaf": 296}, {"work": "equinox1912no8", "page": 126, "leaf": 156, "field": "gd"}]},
        {"english": "the dwelling place", "englishSplit": true, "readings": {"casaubon1659": {"word": "FAORGT", "printed": "ODFAORGT"}, "equinox1912no8": {"word": "faoregita"}}, "note": "second word of Dee entry ODFAORGT. Its pronunciation is printed with the word before.", "sources": [{"work": "casaubon1659", "page": 207, "leaf": 296}, {"work": "equinox1912no8", "page": 126, "leaf": 156, "field": "gd"}]},
        {"english": "of him that is fallen.", "readings": {"casaubon1659": {"word": "TELOCVOVIM", "pronunciation": "lotch, or loch. / Te lóc vo v im."}, "equinox1912no8": {"word": "teloca uo uime", "marker": "split"}}, "note": "\"lotch, or loch.\" printed above the pronunciation; Crowley prints three words \"teloca uo uime\"", "sources": [{"work": "casaubon1659", "page": 207, "leaf": 296}, {"work": "equinox1912no8", "page": 126, "leaf": 156, "field": "gd"}]},
        {"english": "O you heavens", "readings": {"casaubon1659": {"word": "MADRIIAX", "pronunciation": "yax / Má dri iax."}, "equinox1912no8": {"word": "Madariiatza"}}, "note": "the word Dee's note at row 1 refers to (\"about 44 words from the end\": this is row 120 of 163, the 44th from the end counting itself); pronunciation \"Má dri iax.\" with \"yax\" above", "sources": [{"work": "casaubon1659", "page": 207, "leaf": 296}, {"work": "equinox1912no8", "page": 126, "leaf": 156, "field": "gd"}]},
        {"english": "arise,", "readings": {"casaubon1659": {"word": "TORZU", "pronunciation": "Tor zu."}, "equinox1912no8": {"word": "torezodu"}}, "sources": [{"work": "casaubon1659", "page": 207, "leaf": 296}, {"work": "equinox1912no8", "page": 126, "leaf": 156, "field": "gd"}]},
