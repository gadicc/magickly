        {"english": "with Diamond,", "readings": {"casaubon1659": {"word": "ACHILDAO", "pronunciation": "Kil. / A chil da o."}}, "note": "Crowley \"cahisa dao\" for ACHILDAO", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
