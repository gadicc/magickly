        {"english": "liveth", "englishSplit": true, "readings": {"casaubon1659": {"word": "HOM", "dictated": "MOH", "pronunciation": "HOM."}, "equinox1912no8": {"word": "home-tohe"}}, "gdNote": "Crowley joins HOM and TOH", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "and triumpheth", "englishSplit": true, "readings": {"casaubon1659": {"word": "TOH", "dictated": "HOT", "pronunciation": "TOH. There is a point, shewing a stroke, called Virgula."}, "equinox1912no8": {"marker": "joined"}}, "note": "no OD printed between HOM and TOH (the app's earlier text (2023) has OD \"and\"). Casaubon p.84.", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "whose", "englishSplit": true, "readings": {"casaubon1659": {"word": "SOBA", "dictated": "ABOS", "pronunciation": "SOBA"}, "equinox1912no8": {"word": "soba"}}, "note": "replaces three words first dictated after IPAM (DO/OD, HOTLAB \"Call it BALTOH\", PAIP \"Call it Piap\"), which Nalvage then declared false: \"I am deceived from Ipam. O D the next is false, and so are the rest ... ABOS SOBA\"", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "beginning", "englishSplit": true, "unspoken": true, "readings": {"equinox1912no8": {"marker": "absent"}}, "uncertain": true, "note": "not printed: after MAPI (57) Nalvage \"hummed twice, signifying two words more, which were not to be pronounced till they were read in practise\". Two rows hold those two words; their places and English (\"beginning\", \"nor\") are ours, from the running English \"whose beginning is not, nor end can not be\"", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "is not,", "englishSplit": true, "readings": {"casaubon1659": {"word": "IPAM", "dictated": "MAPI"}, "equinox1912no8": {"word": "ipame"}}, "note": "No pronunciation is printed; \"E.K. It seemeth to be an e.\"", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "nor", "englishSplit": true, "unspoken": true, "readings": {"equinox1912no8": {"marker": "absent"}}, "uncertain": true, "note": "the second of the two hummed, unprinted words; see the row before IPAM. The second hummed word.", "sources": [{"work": "casaubon1659", "page": 84, "leaf": 177}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "end", "englishSplit": true, "readings": {"casaubon1659": {"word": "UL", "dictated": "LU", "pronunciation": "Call it UL. Δ, With such sound to U. as we pronounce yew, whereof bows are made."}, "equinox1912no8": {"word": "lu"}}, "note": "LU is the dictated (reversed) form; Nalvage's forward reading is UL. Crowley prints \"lu\"", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "can not be", "englishSplit": true, "readings": {"casaubon1659": {"word": "IPAMIS", "dictated": "SIMAPI", "pronunciation": "Pronounce it IPAMIS. Make a point at S, the A pronounced short."}, "equinox1912no8": {"word": "ipamis"}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "which", "englishSplit": true, "readings": {"casaubon1659": {"word": "DS", "dictated": "SD", "pronunciation": "It is the uppermost of ... Call it DS."}, "equinox1912no8": {"word": "das"}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "shineth", "englishSplit": true, "readings": {"casaubon1659": {"word": "LOHOLO", "dictated": "OLOHOL", "pronunciation": "Call it Loholo. Long, the first syllable accented."}, "equinox1912no8": {"word": "sobolo"}}, "gdNote": "Crowley prints \"sobolo\"", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "as a flame", "englishSplit": true, "readings": {"casaubon1659": {"word": "VEP", "dictated": "PEV", "pronunciation": "It is called Vep. Make a point there. Δ. A full point? Nal. No, no, a stroke."}, "equinox1912no8": {"word": "vepe"}}, "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "in the midst", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZOMDV", "dictated": "XVDMOZ", "pronunciation": "Call it Zome."}, "equinox1912no8": {"word": "zodomeda"}}, "uncertain": true, "note": "capitals print XVDMOZ: the first letter dictated was doubtful (\"it seemed to E.K. to be an X ... At length he said it was V\"), so the print shows both X and V. Read forward with V: ZOMDV. The app's earlier text (2023) and Crowley (\"zodomeda\") have no V. Casaubon p.83.", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "of your Palace,", "englishSplit": true, "readings": {"casaubon1659": {"word": "POAMAL", "dictated": "LAMAOP", "pronunciation": "Poamal Od, put out the S."}, "equinox1912no8": {"word": "poamal"}}, "note": "Dee entry 64 is two words: dictated \"DOS\" (margin \"Also T\") then LAMAOP; \"Make it two words ... It may be all one word with S. or T. ... Make a point between Poamal and Od\"", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "dictated": "DOS"}, "equinox1912no8": {"word": "od"}}, "note": "Its pronunciation is printed with the word before.", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "raigneth", "englishSplit": true, "readings": {"casaubon1659": {"word": "BOGPA", "dictated": "APGOB", "pronunciation": "Call it Bogpa."}, "equinox1912no8": {"word": "bogira"}}, "note": "Casaubon p.83 prints \"APGOB. Call it Bogpa.\"; the app's earlier text (2023) had SONF, the root, here.", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "amongst you", "englishSplit": true, "readings": {"casaubon1659": {"word": "AAI", "dictated": "IAA", "pronunciation": "AAI. The first A may be an A an O or an E. Those are two words."}, "equinox1912no8": {"word": "aai"}}, "note": "dictated as letters I, A, A; \"Those are two words\" is printed under them", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "as", "englishSplit": true, "readings": {"casaubon1659": {"word": "TA", "dictated": "AT", "pronunciation": "TA."}, "equinox1912no8": {"word": "ta"}}, "note": "dictated as letters A, T", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "the Ballance", "englishSplit": true, "readings": {"casaubon1659": {"word": "PIAP", "dictated": "PAIP", "pronunciation": "PIAP."}, "equinox1912no8": {"word": "piape"}}, "note": "dictated as letters P, A, I, P (Saturday 14 April: \"Read backward, letter without number\")", "sources": [{"work": "casaubon1659", "page": 83, "leaf": 176}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "of righteousnesse", "englishSplit": true, "readings": {"casaubon1659": {"word": "PIAMOL", "dictated": "LOMAIP", "pronunciation": "Call it Piamo el. It is Piatel Baltale to be founded."}, "equinox1912no8": {"word": "Piamoel"}}, "note": "dictated letter by letter in two columns: right L, O, M, A, I, P (PIAMOL); left E, L, O, T, L, A, B (BALTOLE), with \"this O must be sounded as A\" and \"T must be instead of M\"; margin \"Aversed\". The forward reading \"Piamo el\" is clear. Crowley prints \"Piamo-el\" across a line break. Casaubon p.81; the app's earlier text (2023) had BALTOH here, which was dictated on 14 April and then declared false (p.84).", "sources": [{"work": "casaubon1659", "page": 81, "leaf": 174}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "dictated": "DO", "pronunciation": "call it O D. [Δ. drawing the O long.]"}, "equinox1912no8": {"word": "od"}}, "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "truth.", "englishSplit": true, "readings": {"casaubon1659": {"word": "VOOAN", "dictated": "NAOOV", "pronunciation": "It is Vooan. It may be founded Vaoan."}, "equinox1912no8": {"word": "Vaoan"}}, "note": "capitals VOOAN; beside it: \"Vooan is spoken with them that fall, but Vaoan with them that are, and are glorified\" (the app's earlier text (2023) VAOAN). Casaubon p.80.", "gdNote": "Crowley's footnote: \"Read here Vooan in invocations of the Fallen Spirits\"", "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "Move", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZACAR", "dictated": "RACAZ", "pronunciation": "E must come after R: but without number, and so, it is Zacare. Call it Zacar."}, "equinox1912no8": {"word": "Zodacare"}}, "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "therefore", "englishSplit": true, "readings": {"casaubon1659": {"word": "CA", "dictated": "AC", "pronunciation": "Call it C A, [Δ. two syllables.]"}, "equinox1912no8": {"word": "eca"}}, "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "dictated": "TO", "pronunciation": "Call it O D ....... or O T."}, "equinox1912no8": {"word": "od"}}, "note": "first letter dictated: \"This may be T or D\"", "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "shew your selves,", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZAMRAN", "dictated": "NARNAZ", "pronunciation": "Zamran. Call it Zanran."}, "equinox1912no8": {"word": "zodameranu"}}, "note": "the fourth letter was dictated N and \"be corrected it M\"; of the fifth \"This A may be an A or an O\"; \"I give it faster unto you, than I received it\"", "sources": [{"work": "casaubon1659", "page": 80, "leaf": 173}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "open", "englishSplit": true, "readings": {"casaubon1659": {"word": "ODO", "dictated": "ODO", "pronunciation": "Call it O D O."}, "equinox1912no8": {"word": "odo"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "the mysteries", "englishSplit": true, "readings": {"casaubon1659": {"word": "CICLE", "dictated": "ELCIC", "pronunciation": "Call it Cicle."}, "equinox1912no8": {"word": "cicale"}}, "note": "printed without a number (QAA is 79, ODO 76; the right margin has \"7877\"); \"That C. is called C Minor\"", "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "of your Creation,", "englishSplit": true, "readings": {"casaubon1659": {"word": "QAA", "dictated": "AAQ", "pronunciation": "Call it Q A A. [Three syllables with accent on the last A.]"}, "equinox1912no8": {"word": "Qaa"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "be friendly unto me;", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZORGE", "dictated": "EGROZ", "pronunciation": "Call it Zorge. [Of one syllable.]"}, "equinox1912no8": {"word": "zodoreje"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "for", "englishSplit": true, "readings": {"casaubon1659": {"word": "LAP", "dictated": "PAL", "pronunciation": "Call it Lap."}, "equinox1912no8": {"word": "lape"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "I am", "englishSplit": true, "readings": {"casaubon1659": {"word": "ZIRDO", "dictated": "ODRIZ", "pronunciation": "Call it Zirdo."}, "equinox1912no8": {"word": "zodiredo"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "the servant", "englishSplit": true, "readings": {"casaubon1659": {"word": "NOCO", "dictated": "OCON", "pronunciation": "Call it Noco."}, "equinox1912no8": {"word": "Noco"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "of the same your God,", "englishSplit": true, "readings": {"casaubon1659": {"word": "MAD", "dictated": "DAM", "pronunciation": "Call it Mad."}, "equinox1912no8": {"word": "Mada"}}, "note": "first letter line printed \"225.\" with the letter D on the next line (\"The same number repeated\")", "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "the true worshipper", "englishSplit": true, "readings": {"casaubon1659": {"word": "HOATH", "dictated": "HTAOH", "pronunciation": "call it Hoath."}, "equinox1912no8": {"word": "Hoathahe"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]},
        {"english": "of the Highest.", "englishSplit": true, "readings": {"casaubon1659": {"word": "IAIDA", "dictated": "ADIAI", "pronunciation": "Jaida you shall understand ... Jaida is the last word of the call."}, "equinox1912no8": {"word": "IAIDA"}}, "sources": [{"work": "casaubon1659", "page": 79, "leaf": 172}, {"work": "equinox1912no8", "page": 103, "leaf": 133, "field": "gd"}]}
      ]
    },
    {
      "key": 2,
      "dictated": "\"Wensday morning, Aprilis 1584\" (no day printed; follows Dee's note of Wednesday night 25 April), Cracow; \"A new Action — Backward, as before\"",
      "note": "not numbered where dictated; by order received the third (after Key 1, 13-14 April, and Key 3, 25 April, pp.94-98). Dee's note p.98 (n191): \"There are three calls in the second part of Cracovia, and one in the first. These four calls are the second, the 3d. 4th. 5th. for the first Table can have no call, it is of the Godhead.\"",
      "sources": [{"work": "casaubon1659", "page": 99, "leaf": 192}, {"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}],
      "checked": {"date": "2026-11-10", "works": ["casaubon1659", "equinox1912no8"], "covered": ["enochian", "english", "gd"], "notCovered": ["Sloane MS 3191, Dee's own copy, whose images are offline", "a second reading of every word (a random quarter was read twice)"]},
      "rows": [
        {"english": "Can", "readings": {"casaubon1659": {"word": "ADGT", "dictated": "TGDA", "pronunciation": "Adgt."}, "equinox1912no8": {"word": "Adagita"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "the wings", "readings": {"casaubon1659": {"word": "VPAAH", "dictated": "HAAPV", "pronunciation": "V pa ah."}, "equinox1912no8": {"word": "vau-pa-ahe"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "of the windes", "readings": {"casaubon1659": {"word": "ZONG", "dictated": "GNOZ", "pronunciation": "Zong."}, "equinox1912no8": {"word": "zodonugonu"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "", "readings": {"casaubon1659": {"word": "OM", "dictated": "MO", "pronunciation": "Om."}, "equinox1912no8": {"marker": "absent"}}, "note": "Casaubon's table prints no English against OM: \"understand\" stands on FAAIP's line and \"your voices of wonder\" on SALD's, as in the app's earlier text (2023). Dee's list (p.101, n194) gives the three words as one item, \"4 understand your voices of windes\".", "gdNote": "Crowley omits OM: \"zodonugonu fa-a-ipe salada\"", "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "understand", "readings": {"casaubon1659": {"word": "FAAIP", "dictated": "PIAAF", "pronunciation": "Fa á ip."}, "equinox1912no8": {"word": "fa-a-ipe"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "your voices of wonder", "readings": {"casaubon1659": {"word": "SALD", "dictated": "DLAS", "pronunciation": "Sald."}, "equinox1912no8": {"word": "salada"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "O you the second", "readings": {"casaubon1659": {"word": "VIIV", "dictated": "VIIV", "pronunciation": "Vi iv."}, "equinox1912no8": {"word": "Vi-i-vau"}}, "note": "the app's earlier text (2023) VIV. Casaubon p.100.", "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "of the first", "readings": {"casaubon1659": {"word": "L", "dictated": "L", "pronunciation": "A word."}, "equinox1912no8": {"word": "el"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "whom", "readings": {"casaubon1659": {"word": "SOBAM", "dictated": "MABOS", "pronunciation": "S o bam."}, "equinox1912no8": {"word": "Sobame"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "the burning flames", "readings": {"casaubon1659": {"word": "IALPURG", "dictated": "GRUPLAI", "pronunciation": "I al purg."}, "equinox1912no8": {"word": "ial-pereji"}}, "note": "capitals GRUPLAI read forward IALPURG (the app's earlier text (2023) IALPRG). Casaubon p.100.", "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "have framed", "readings": {"casaubon1659": {"word": "IZAZAZ", "dictated": "ZAZAZI", "pronunciation": "Izazaz."}, "equinox1912no8": {"word": "i-zoda-zodazod"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "within the depth of my Jaws", "readings": {"casaubon1659": {"word": "PIADPH", "dictated": "HPDAIP", "pronunciation": "Piadph."}, "equinox1912no8": {"word": "pi-adapehe"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "whom", "readings": {"casaubon1659": {"word": "CASARMA", "dictated": "AMRASAC", "pronunciation": "Casarma."}, "equinox1912no8": {"word": "casarema"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
        {"english": "I have prepared", "readings": {"casaubon1659": {"word": "ABRAMG", "dictated": "GMARBA", "pronunciation": "Abramg."}, "equinox1912no8": {"word": "aberameji"}}, "sources": [{"work": "casaubon1659", "page": 100, "leaf": 193}, {"work": "equinox1912no8", "page": 104, "leaf": 134, "field": "gd"}]},
