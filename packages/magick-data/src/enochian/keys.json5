        {"english": "I made a Law", "readings": {"casaubon1659": {"word": "OHORELA", "dictated": "ALEROHO", "pronunciation": "Call it Ohorela |"}}, "note": "Nalvage: \"There is a stop, shewing a stroke made straight down\"", "sources": [{"work": "casaubon1659", "page": 85, "leaf": 178}]},
        {"english": "govern", "readings": {"casaubon1659": {"word": "CABA", "dictated": "ABAC", "pronunciation": "Call it Caba."}}, "note": "running English p.87: \"to govern\"", "sources": [{"work": "casaubon1659", "page": 85, "leaf": 178}]},
        {"english": "the holy ones", "readings": {"casaubon1659": {"word": "PIR", "dictated": "RIP", "pronunciation": "Pir, there is a point"}}, "sources": [{"work": "casaubon1659", "page": 85, "leaf": 178}]},
