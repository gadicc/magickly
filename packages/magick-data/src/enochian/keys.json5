        {"english": "Hearken unto", "readings": {"casaubon1659": {"word": "SOLPETH", "pronunciation": "Sol peth."}, "equinox1912no8": {"word": "Sol-petahe-bienu"}}, "note": "Crowley joins SOLPETH and BIEN; his first hyphen falls at a line end", "sources": [{"work": "casaubon1659", "page": 190, "leaf": 279, "field": "english"}, {"work": "casaubon1659", "page": 122, "leaf": 211, "field": "enochian"}, {"work": "equinox1912no8", "page": 113, "leaf": 143, "field": "gd"}]},
        {"english": "my voice,", "readings": {"casaubon1659": {"word": "BIEN", "pronunciation": "Bi en."}, "equinox1912no8": {"marker": "joined"}}, "sources": [{"work": "casaubon1659", "page": 190, "leaf": 279, "field": "english"}, {"work": "casaubon1659", "page": 122, "leaf": 211, "field": "enochian"}, {"work": "equinox1912no8", "page": 113, "leaf": 143, "field": "gd"}]},
