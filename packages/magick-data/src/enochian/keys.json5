        {"english": "over you", "readings": {"casaubon1659": {"word": "VORSG", "dictated": "GSROV", "pronunciation": "Vorsg. Here a point."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "saith", "readings": {"casaubon1659": {"word": "GOHO", "dictated": "OHOG", "pronunciation": "GOTTO."}}, "note": "forward column misprints \"GOTTO.\"; the caps OHOG read forward GOHO", "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "the God", "readings": {"casaubon1659": {"word": "IAD", "dictated": "DAI", "pronunciation": "Iad, as Yad."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "of Justice", "readings": {"casaubon1659": {"word": "BALT", "dictated": "TLAB", "pronunciation": "Balt. Here is a point."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "in power exalted", "readings": {"casaubon1659": {"word": "LANSH", "dictated": "HSNAL", "pronunciation": "LANSH as Lonsh."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "above the firmamets", "readings": {"casaubon1659": {"word": "CALZ", "dictated": "ZLAC", "pronunciation": "Calz."}}, "note": "gloss printed \"firmamets\"; the running English on p.87 has \"firmaments\"", "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "of wrath", "readings": {"casaubon1659": {"word": "VONPHO", "dictated": "OHPNOV", "pronunciation": "Vonpho."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "in whose", "readings": {"casaubon1659": {"word": "SOBRA", "dictated": "ARBOS", "pronunciation": "Sobra."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "hands", "readings": {"casaubon1659": {"word": "ZOL", "dictated": "LOZ", "pronunciation": "Zol ... zod Δ, as ol: A point."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
        {"english": "The Sun", "readings": {"casaubon1659": {"word": "ROR", "dictated": "ROR", "pronunciation": "Ror. Here a point."}}, "sources": [{"work": "casaubon1659", "page": 86, "leaf": 179}]},
