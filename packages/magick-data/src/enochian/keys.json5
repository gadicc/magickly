        {"english": "vexing", "notInCasaubon": true, "readings": {"equinox1912no8": {"word": "dodasa"}}, "note": "Not in Casaubon's print: the Enochian of Key 14 is not printed (manuscript loss, pp.133-138). Row and its English follow Crowley's word division; the pairing of his word with Dee's English is ours.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "equinox1912no8", "page": 121, "leaf": 151, "field": "gd"}]},
        {"english": "all creatures", "notInCasaubon": true, "readings": {"equinox1912no8": {"word": "tolahame"}}, "note": "Not in Casaubon's print: the Enochian of Key 14 is not printed (manuscript loss, pp.133-138). Row and its English follow Crowley's word division; the pairing of his word with Dee's English is ours.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "equinox1912no8", "page": 121, "leaf": 151, "field": "gd"}]},
        {"english": "of the earth", "notInCasaubon": true, "readings": {"equinox1912no8": {"word": "caosago"}}, "note": "Not in Casaubon's print: the Enochian of Key 14 is not printed (manuscript loss, pp.133-138). Row and its English follow Crowley's word division; the pairing of his word with Dee's English is ours.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "equinox1912no8", "page": 121, "leaf": 151, "field": "gd"}]},
        {"english": "with age", "notInCasaubon": true, "readings": {"equinox1912no8": {"word": "homida"}}, "note": "Not in Casaubon's print: the Enochian of Key 14 is not printed (manuscript loss, pp.133-138). Row and its English follow Crowley's word division; the pairing of his word with Dee's English is ours. Crowley italicises the h of 'homida'.", "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "equinox1912no8", "page": 121, "leaf": 151, "field": "gd"}]},
