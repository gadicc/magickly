        {"english": "iniquities", "readings": {"casaubon1659": {"word": "MADRID", "pronunciation": "Ma drid", "printed": ".ADRID"}}, "note": "DAMAGED. Caps \".ADRID\"; M from the pronunciation \"Ma drid\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
