        {"english": "The seat of mercy", "readings": {"casaubon1659": {"word": "OTHILRIT", "pronunciation": "O thil rit."}, "equinox1912no8": {"word": "itahila rita", "marker": "split"}}, "gdEnglish": "the Seats of Mercy", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od mi am. / Kol.", "printed": "ODMIAM"}, "equinox1912no8": {"word": "od"}}, "note": "capitals entry ODMIAM is OD + MIAM; English line \"and continuance.\" split", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "continuance.", "englishSplit": true, "readings": {"casaubon1659": {"word": "MIAM", "printed": "ODMIAM"}, "equinox1912no8": {"word": "miame"}}, "note": "Its pronunciation is printed with the word before.", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "O you servants", "englishSplit": true, "readings": {"casaubon1659": {"word": "CNOQUOL", "pronunciation": "Cno quol."}, "equinox1912no8": {"word": "ca-ni-quola"}}, "note": "English line \"O you servants of mercy.\" split over CNOQUOL / RIT", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "of mercy.", "englishSplit": true, "readings": {"casaubon1659": {"word": "RIT", "pronunciation": "Rit."}, "equinox1912no8": {"word": "rita"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "Move,", "readings": {"casaubon1659": {"word": "ZACAR", "pronunciation": "Za car."}, "equinox1912no8": {"word": "Zodacare"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "appear,", "readings": {"casaubon1659": {"word": "ZAMRAN", "pronunciation": "Zam ran."}, "equinox1912no8": {"word": "Zodameranu"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 124, "leaf": 213, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "sing praises", "readings": {"casaubon1659": {"word": "OECRIMI", "pronunciation": "O é crimi."}, "equinox1912no8": {"word": "Iecarimi"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "unto the Creator,", "readings": {"casaubon1659": {"word": "QADAH", "pronunciation": "Qá dah.", "printed": "QADA:"}, "equinox1912no8": {"word": "Quo-a-dahe"}}, "note": "Damaged in the print. A colon prints for the last letter (\"QADA:\"); H from the pronunciation \"Qá dah.\"; Crowley's first hyphen falls at a line end", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}, "equinox1912no8": {"word": "od"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "be mighty", "readings": {"casaubon1659": {"word": "OMICAOLZ", "pronunciation": "O mi ca ol zod."}, "equinox1912no8": {"word": "I-mica-ol-zododa"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "amongst us,", "readings": {"casaubon1659": {"word": "AAIOM", "pronunciation": "A A I om."}, "equinox1912no8": {"word": "aaiome"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "for", "readings": {"casaubon1659": {"word": "BAGLE", "pronunciation": "Ba gle."}, "equinox1912no8": {"word": "Bajirele"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "unto this remembrance", "readings": {"casaubon1659": {"word": "PAPNOR", "pronunciation": "Pap nor."}, "equinox1912no8": {"word": "papenore"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "is given", "readings": {"casaubon1659": {"word": "IDLUGAM", "pronunciation": "Id lú gam."}, "equinox1912no8": {"word": "idalu-gama"}}, "note": "Crowley's hyphen falls at a line end", "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "power,", "readings": {"casaubon1659": {"word": "LONSHI", "pronunciation": "Lon shi."}, "equinox1912no8": {"word": "elonusahi"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "and", "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od."}, "equinox1912no8": {"word": "od"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
        {"english": "our strength", "readings": {"casaubon1659": {"word": "VMPLIF", "pronunciation": "Vmp lif."}, "equinox1912no8": {"word": "umapelifa"}}, "sources": [{"work": "casaubon1659", "page": 199, "leaf": 288, "field": "english"}, {"work": "casaubon1659", "page": 125, "leaf": 214, "field": "enochian"}, {"work": "equinox1912no8", "page": 114, "leaf": 144, "field": "gd"}]},
