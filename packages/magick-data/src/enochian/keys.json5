        {"english": "is as", "readings": {"casaubon1659": {"word": "TA", "pronunciation": "Ta."}, "equinox1912no8": {"word": "ta"}}, "sources": [{"work": "casaubon1659", "page": 193, "leaf": 282, "field": "english"}, {"work": "casaubon1659", "page": 134, "leaf": 223, "field": "enochian"}, {"work": "equinox1912no8", "page": 119, "leaf": 149, "field": "gd"}]},
