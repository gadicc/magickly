        {"english": "are measured", "readings": {"casaubon1659": {"word": "CHISHOLQ", "pronunciation": "Chis hol q."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "with their Ministers,", "readings": {"casaubon1659": {"word": "CNOQVODI", "pronunciation": "Cno quo di."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "9996", "readings": {"casaubon1659": {"word": "CIAL", "pronunciation": "Si i. / Ci al."}}, "note": "margin \"96\" by the caps; beside \"These\" p.191: \"C.al, that you have not.\"; English printed \"9996 ---- That is,\"", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "These", "readings": {"casaubon1659": {"word": "VNAL", "pronunciation": "V nal."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "gather up", "readings": {"casaubon1659": {"word": "ALDON", "pronunciation": "Al don."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "the Mosse", "readings": {"casaubon1659": {"word": "MOM", "pronunciation": "Mom."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "of the earth,", "readings": {"casaubon1659": {"word": "CAOSGO", "pronunciation": "Ca os go."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "[as]", "englishSplit": true, "readings": {"casaubon1659": {"word": "TA", "pronunciation": "Ta."}}, "note": "English line \"[as] the rich man\", the bracket Casaubon's, split over TA / LASOLLOR", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "the rich man", "englishSplit": true, "readings": {"casaubon1659": {"word": "LASOLLOR", "pronunciation": "Las ol lor.", "printed": "LA. LLOR"}}, "uncertain": true, "note": "DAMAGED. Caps \"LA. LLOR\" with a gap; S, O from the pronunciation \"Las ol lor.\". Printed as one caps line but the gap may divide two words (LAS OLLOR, as Crowley); uncertain. Crowley iasa for LAS", "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "doth", "readings": {"casaubon1659": {"word": "GNAY", "pronunciation": "Gnay."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 128, "leaf": 217, "field": "enochian"}]},
        {"english": "his Treasure,", "readings": {"casaubon1659": {"word": "LIMLAL", "pronunciation": "Lim lal."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
        {"english": "cursed", "readings": {"casaubon1659": {"word": "AMMA", "pronunciation": "Am ma."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
        {"english": "are they", "readings": {"casaubon1659": {"word": "CHIIS", "pronunciation": "Chiis."}}, "sources": [{"work": "casaubon1659", "page": 191, "leaf": 280, "field": "english"}, {"work": "casaubon1659", "page": 129, "leaf": 218, "field": "enochian"}]},
