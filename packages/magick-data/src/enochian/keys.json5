        {"english": "and", "englishSplit": true, "readings": {"casaubon1659": {"word": "OD", "pronunciation": "Od brint.", "printed": "ODBRINT (one entry)"}, "equinox1912no8": {"word": "od"}}, "note": "The capitals print ODBRINT as one entry; split OD + BRINT (Dee's rule for OD + word; Crowley \"od berinuta\"). English line \"and hast\".", "sources": [{"work": "casaubon1659", "page": 194, "leaf": 283, "field": "english"}, {"work": "casaubon1659", "page": 135, "leaf": 224, "field": "enochian"}, {"work": "equinox1912no8", "page": 123, "leaf": 153, "field": "gd"}]},
