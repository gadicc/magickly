        {"english": "moreover", "readings": {"casaubon1659": {"word": "PILAH", "dictated": "HALIP", "pronunciation": "PILAH. Three syllables."}}, "note": "margin: \"P is distinctly pronounced by it self\"", "sources": [{"work": "casaubon1659", "page": 85, "leaf": 178}]},
        {"english": "you lifted up your voices", "englishSplit": true, "readings": {"casaubon1659": {"word": "FARZM", "dictated": "MZRAF", "pronunciation": "FARZM."}}, "note": "no gloss at dictation from here to the end (entries 48-86); English split by us from the running English pp.87-88 (n180-n181)", "sources": [{"work": "casaubon1659", "page": 85, "leaf": 178}]},
