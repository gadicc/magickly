            "page": 15,
            "leaf": 456
          }
        ]
      },
      {
        "row": 8,
        "column": 0,
        "note": "One of the eight smallest letters Dee picked out, which spell Paraoan. The Equinox writes it in Enochian; a reversed A looks the same as a plain one.",
        "sources": [
