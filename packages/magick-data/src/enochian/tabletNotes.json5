// Notes on the Enochian tablets: where their versions come from, how they
// differ, and what the sources print in particular squares. Original
// prose, facts only, citing the works below by stable reference; plan 061
// (Stage G notes) has the transcriptions' account. Rows and columns are
// counted from 0, as in tablets.json5's grids and marks; `printed` gives
// each source's letters in that square ("x over y" where Regardie prints
// a higher and a lower letter).
{
  works: {
    "sloane3191": {
      "title": "John Dee, the Enochian tables and invocations, British Library, Sloane MS 3191",
      "year": 1584
    },
    "casaubon1659": {
      "title": "Meric Casaubon (ed.), A True & Faithful Relation of what passed for many Yeers between Dr. John Dee and Some Spirits (London, 1659), from British Library, Cotton MS Appendix XLVI",
      "year": 1659,
      "archive": {
        "item": "truefaithfulrela00deej"
      }
    },
    "equinox1912": {
      "title": "The Equinox, vol. I no. 7 (London, 1912), \"Liber Chanokh\"",
      "year": 1912,
      "archive": {
        "item": "crowley-equinox_202110",
        "file": "The Equinox Vol. 1, No. 7"
      }
    },
    "regardie1940": {
      "title": "Israel Regardie, The Golden Dawn, vol. 4 (Aries Press, Chicago, 1940)",
      "year": 1940,
      "archive": {
        "item": "IsraelRegardie-TheGoldenDawn-Vol4-1940"
      }
    },
    "greer": {
      "title": "Israel Regardie, The Golden Dawn, 7th edition, ed. John Michael Greer (Llewellyn)",
      "isbn": "978-0-7387-4399-8"
    }
  },
  versions: [
    {
      "id": "dee1584",
      "title": "Dee and Kelley, 1584",
      "text": "John Dee recorded the four Watchtowers, joined into one Great Table, from Edward Kelley's scrying in 1584. Dee's own copy of the tables is among his papers in the British Library. The letters were given square by square.",
      "sources": [
        {
          "work": "sloane3191"
        }
      ]
    },
    {
      "id": "raphael1587",
      "title": "Raphael's revision, 1587",
      "text": "Dee's records also tell of a revised version of the table, given through Kelley in 1587 and known as the Tabula recensa. His diaries of the sessions with Kelley were printed in 1659.",
      "sources": [
        {
          "work": "casaubon1659"
        }
      ]
    },
    {
      "id": "gd",
      "title": "The Golden Dawn",
      "text": "The Hermetic Order of the Golden Dawn worked from copies of Dee's tables. Its tablets keep his letters with some changes, print a second letter in many squares, attribute each tablet to an element and a quarter, and add a Tablet of Union, colours and a layer of attributions on every square.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 270,
          "leaf": 262
        },
        {
          "work": "regardie1940",
          "page": 306,
          "leaf": 298
        }
      ]
    },
    {
      "id": "printings",
      "title": "Later printings",
      "text": "The Order's tablets reached print in The Equinox (1912), which gives them whole and with the Black Cross, square by square as pyramids, and with the Tablet of Union; in Regardie's The Golden Dawn (1937 to 1940), the Order's own papers, with the second letters; and in modern editions, of which the seventh, edited by John Michael Greer, redraws them in colour with one letter a square. The three disagree in a few squares each.",
      "sources": [
        {
          "work": "equinox1912",
          "plate": "III",
          "leaf": 241
        },
        {
          "work": "regardie1940",
          "page": 270,
          "leaf": 262
        },
        {
          "work": "greer"
        }
      ]
    }
  ],
  differences: [
    {
      "id": "letters",
      "title": "Letters",
      "text": "Most squares hold the same letter in every version. Where they differ it is usually by a letter that looks alike in a hand or in print (z and x, c and t, n and u), by u against v, which were one letter in Dee's day, or by a capital.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 270,
          "leaf": 262
        },
        {
          "work": "equinox1912",
          "plate": "III",
          "leaf": 241
        }
      ]
    },
    {
      "id": "doubled",
      "title": "Squares with two letters",
      "text": "Regardie prints a second, smaller letter in many squares, and once four. He treats either letter as valid for the square, prefers the higher, and allows both; the Order's names sometimes draw on both. The Equinox and Greer print one letter a square. Here the grid takes the higher letter unless both other sources and the Order's names read another, and the other letters are kept as variants.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 306,
          "leaf": 298
        }
      ]
    },
    {
      "id": "reversed",
      "title": "Reversed letters",
      "text": "A few letters are printed reversed. Most of them, one or two in each Watchtower, spell Paraoan, the name of one of the governors of the Aethyrs. The Equinox writes them in Enochian, since a reversed A or O cannot be told from a plain one, and Greer mirrors them. Both also reverse one letter outside that name, Water's last, an L.",
      "sources": [
        {
          "work": "equinox1912",
          "page": 234,
          "leaf": 240
        },
        {
          "work": "greer"
        }
      ]
    },
    {
      "id": "earthRow8",
      "title": "The eighth row of Earth",
      "text": "The eighth row of the Earth tablet differs most: Regardie prints two readings in every square, the lower one shifted a square along, and the Equinox and Greer each follow a different mixture of them. The older reading kept here begins with O; the Golden Dawn's begins with R, printed reversed.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 272,
          "leaf": 264
        },
        {
          "work": "equinox1912",
          "plate": "III",
          "leaf": 241
        },
        {
          "work": "greer"
        }
      ]
    },
    {
      "id": "union",
      "title": "The Tablet of Union",
      "text": "The Tablet of Union is the Order's: twenty letters in five columns and four rows, EXARP, HCOMA, NANTA and BITOM, one line to each element. The same letters stand in the Black Cross that joins the four Watchtowers in the Equinox's general view.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 275,
          "leaf": 267
        },
        {
          "work": "equinox1912",
          "plate": "III",
          "leaf": 241
        },
        {
          "work": "equinox1912",
          "plate": "VIII",
          "leaf": 246
        }
      ]
    },
    {
      "id": "attributions",
      "title": "Elements and quarters",
      "text": "The Order gives each Watchtower an element and a quarter: Air the East, Water the West, Earth the North and Fire the South, and divides each into four lesser angles, one for each element. This is the Order's scheme; other writers attribute the tablets differently.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 270,
          "leaf": 262
        },
        {
          "work": "equinox1912",
          "page": 234,
          "leaf": 240
        }
      ]
    },
    {
      "id": "colours",
      "title": "Colours and pyramids",
      "text": "The Order painted each tablet in its element's colour and its own angle's letters in the complementary one, the crosses black on white, and the Tablet of Union white with each line in its element's colour. It also treats every square as a truncated pyramid whose sides carry elements, signs, planets and other attributions, as the Equinox draws them.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 274,
          "leaf": 266
        },
        {
          "work": "regardie1940",
          "page": 275,
          "leaf": 267
        },
        {
          "work": "equinox1912",
          "plate": "IV",
          "leaf": 242
        }
      ]
    }
  ],
  tablets: {
    "earth": {
      "version": "older",
      "text": "The Watchtower of the North, Earth. This tablet's letters predate the sources recorded here and have no source of their own. They differ from the Golden Dawn's in thirteen squares: capitals, u for v, and four letters, two of them in the eighth row. A comparison with a modern transcription of Dee's table suggests they follow it. Its sigil is a cross with arms of four colours.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 272,
          "leaf": 264
        },
        {
          "work": "regardie1940",
          "page": 307,
          "leaf": 299
        }
      ]
    },
    "air": {
      "version": "older",
      "text": "The Watchtower of the East, Air. This tablet's letters predate the sources recorded here and have no source of their own. They differ from the Golden Dawn's in thirteen squares: capitals, u for v, and two letters. A comparison with a modern transcription of Dee's table suggests they follow it. Its sigil is a Tau with four flames above it.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 270,
          "leaf": 262
        },
        {
          "work": "regardie1940",
          "page": 307,
          "leaf": 299
        }
      ]
    },
    "water": {
      "version": "gd",
      "text": "The Watchtower of the West, Water, as the Golden Dawn has it. Regardie prints a second letter in twenty of its squares; the grid takes his letter except in six squares, each with a note of its own. Its sigil is a cross potent with b, 6, 4 and b in its angles; the Equinox sets the four figures differently.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 271,
          "leaf": 263
        },
        {
          "work": "regardie1940",
          "page": 307,
          "leaf": 299
        },
        {
          "work": "equinox1912",
          "plate": "X",
          "leaf": 256
        }
      ]
    },
    "fire": {
      "version": "gd",
      "text": "The Watchtower of the South, Fire, as the Golden Dawn has it. Regardie prints a second letter in ten of its squares; the grid takes his letter except in three squares, each with a note of its own. Its sigil is a circle with twelve rays.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 273,
          "leaf": 265
        },
        {
          "work": "regardie1940",
          "page": 307,
          "leaf": 299
        },
        {
          "work": "equinox1912",
          "plate": "X",
          "leaf": 256
        }
      ]
    },
    "union": {
      "version": "gd",
      "text": "The Tablet of Union, by which the Golden Dawn joins the four Watchtowers: EXARP for Air, HCOMA for Water, NANTA for Earth and BITOM for Fire. It has no sigil and no variants in these sources.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 275,
          "leaf": 267
        },
        {
          "work": "equinox1912",
          "plate": "VIII",
          "leaf": 246
        }
      ]
    }
  },
