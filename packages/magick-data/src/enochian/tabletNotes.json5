        }
      ]
    },
    {
      "id": "union",
      "title": "The Tablet of Union",
      "text": "The Tablet of Union is the Golden Dawn's construction: twenty letters in five columns and four rows, EXARP, HCOMA, NANTA and BITOM, one line to each element. Its letters are those of Dee's Black Cross, which binds the four tables together: Dee was given them in names (pp.179-180), with the rule for reading them into the tables' names. Dee's and Raphael's versions have no Tablet of Union, and the Black Cross itself is not yet in this data.",
      "sources": [
        {
          "work": "regardie1940",
          "page": 275,
          "leaf": 267
        },
        {
          "work": "equinox1912",
          "plate": "III",
          "leaf": 241
        },
        {
          "work": "equinox1912",
          "plate": "VIII",
          "leaf": 246
        },
        {
          "work": "casaubon1659",
          "page": 179,
          "leaf": 268
        },
        {
          "work": "casaubon1659",
          "page": 180,
