    english: "F",
    names: { gd: "Orth", dee: "Or" },
    sounds: { gd: "ef", dee: "f" },
    tetragramId: "cauda_draconis",
  },
  G: {
    id: "G",
    enochian: "G",
    english: "G",
    names: { gd: "Ged", dee: "Ged" },
    sounds: { gd: "jee, ghee", dee: "g, j" },
    tetragramId: "fortuna_major",
  },
  H: {
    id: "H",
    enochian: "H",
    english: "H",
    names: { gd: "Na-hath", dee: "Na" },
    sounds: { gd: "heh", dee: "h" },
  },
  I: {
    id: "I",
    enochian: "I",
    english: "I,Y,J",
    names: { gd: "Gon", dee: "Gon" },
    sounds: { gd: "ee", dee: "i, y, j" },
    tetragramId: "acquisitio",
  },
  L: {
    id: "L",
    enochian: "L",
    english: "L",
    names: { gd: "Ur", dee: "Ur" },
    sounds: { gd: "el", dee: "l" },
    tetragramId: "via",
  },
  M: {
    id: "M",
    enochian: "M",
    english: "M",
    names: { gd: "Tal", dee: "Tal" },
    sounds: { gd: "em", dee: "m" },
    tetragramId: "tristitia",
  },
  N: {
    id: "N",
    enochian: "N",
    english: "N",
    names: { gd: "Drun", dee: "Drux" },
    sounds: { gd: "en, noo", dee: "n" },
    tetragramId: "rubeus",
  },
  O: {
    id: "O",
    enochian: "O",
    english: "O",
    names: { gd: "Med", dee: "Med" },
    sounds: { gd: "oh", dee: "o" },
    tetragramId: "puella",
  },
  P: {
    id: "P",
    enochian: "P",
    english: "P",
    names: { gd: "Mals", dee: "Mals" },
    sounds: { gd: "peh", dee: "p, ph" },
    tetragramId: "populus",
  },
  Q: {
    id: "Q",
    enochian: "Q",
    english: "Q",
    names: { gd: "Ger", dee: "Ger" },
    sounds: { gd: "quo", dee: "qu" },
  },
  R: {
    id: "R",
    enochian: "R",
    english: "R",
    names: { gd: "Don", dee: "Don" },
    sounds: { gd: "reh, ar", dee: "r, ur" },
    tetragramId: "laetitia",
  },
  S: {
    id: "S",
    enochian: "S",
    english: "S",
    names: { gd: "Fam", dee: "Fam" },
    sounds: { gd: "ess", dee: "s, sh" },
    tetragramId: "conjunctio",
  },
  T: {
