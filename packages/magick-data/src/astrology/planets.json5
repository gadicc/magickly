  uranus: {
    id: "uranus",
    kind: "planet",
    symbol: "⛢",
    name: {
      en: {
        en: "Uranus",
      },
    },
    about: {
      en: "William Herschel found Uranus on 13 March 1781 and took it at first for a comet: the first planet discovered since antiquity, and too late for the classical correspondences, which were drawn up for seven. Modern astrologers give it Aquarius, a sign tradition gives to Saturn, though Alan Leo, early in the twentieth century, still called that unsettled. Astronomers write its symbol ⛢, the sign of platinum; astrologers draw ♅, an H for Herschel.",
    },
    description: {
      en: "Uranus ⛢ ♅: found by Herschel in 1781, too late for the classical correspondences; its modern rulership of Aquarius, and its two symbols.",
    },
  },

  neptune: {
    id: "neptune",
    kind: "planet",
    symbol: "♆",
    name: {
      en: {
        en: "Neptune",
      },
    },
    about: {
      en: "Neptune was found at Berlin in September 1846, close to where Urbain Le Verrier had calculated it must be from the way it pulled Uranus off course. Like Uranus it came too late for the classical correspondences. Modern astrologers give it Pisces, a sign tradition gives to Jupiter; in Alan Leo’s day some gave it Capricorn instead.",
    },
    description: {
      en: "Neptune ♆: found at Berlin in 1846 near where Le Verrier had predicted, too late for the classical correspondences; its modern rulership of Pisces.",
    },
  },

  rahu: {
    id: "rahu",
    kind: "planet",
    commonName: "North Node",
    symbol: "☊",
    name: {
      en: {
        en: "Caput Draconis",
      },
    },
    about: {
      en: "The Dragon’s Head is the Moon’s north node, the point where the Moon’s path crosses the ecliptic going north; the south node, the Dragon’s Tail, lies opposite. Eclipses happen only when the Sun and Moon are near the nodes. Astrologers count the Head favourable, like Jupiter or Venus. In Sanskrit it is Rahu, the demon said to cause eclipses. The geomantic figure Caput Draconis carries its name.",
    },
    description: {
      en: "The North Node, Caput Draconis ☊: the Dragon’s Head, one of the two points where eclipses happen; favourable like Jupiter and Venus, and Rahu in Sanskrit.",
    },
  },

