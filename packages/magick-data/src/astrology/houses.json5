// What each house signifies, in our own words, from William Lilly,
// Christian Astrology (London, 1647), Book I, chap. VII, "Of the twelve
// Houses, their Nature and signification", pp. 50-56 (public domain;
// archive.org b30338724, leaves n84-n90). They follow Lilly, not modern
// astrology: the father is the 4th house's and the mother the 10th's.
//
// The mottos are not from Lilly. Their Latin is the mnemonic verse as
// usually quoted, a word for each house: "Vita, lucrum, fratres, genitor,
// nati, valetudo, uxor, mors, pietas, regnum, benefactaque, carcer". We
// found no public-domain printing of it to cite. The table this file
// replaced had Iter for the ninth. The English renderings are ours.

[
  {
    index: 1,
    zodiacId: "aries",
    motto: {
      la: "Vita",
      en: "Life",
    },
    interpretation: {
      en: "The life of the one who asks or is born, and their body: stature, colouring, complexion and shape. In a chart for an eclipse, a great conjunction or the Sun's entry into Aries, the common people of the realm.",
    },
  },
  {
    index: 2,
    zodiacId: "taurus",
    motto: {
      la: "Lucrum",
      en: "Gain",
    },
    interpretation: {
      en: "The querent's estate and fortune: riches or poverty, money and movable goods, profit and loss. In a lawsuit, a person's friends and helpers.",
    },
  },
  {
    index: 3,
    zodiacId: "gemini",
    motto: {
      la: "Fratres",
      en: "Brothers",
    },
    interpretation: {
      en: "Brothers, sisters, cousins and other kin; neighbours. Short journeys inland and frequent moves. Letters, messengers and rumours.",
    },
  },
  {
    index: 4,
    zodiacId: "cancer",
    motto: {
      la: "Genitor",
      en: "Father",
    },
    interpretation: {
      en: "The father; lands, houses and inheritance; tilling the ground and hidden treasure; towns, old dwellings, gardens and fields. The end of any matter.",
    },
  },
  {
    index: 5,
    zodiacId: "leo",
    motto: {
      la: "Nati",
      en: "Children",
    },
    interpretation: {
      en: "Children, and a woman with child: whether a boy or a girl. Pleasure, feasts, taverns and plays. Ambassadors, messengers and agents.",
    },
  },
  {
    index: 6,
    zodiacId: "virgo",
    motto: {
      la: "Valetudo",
      en: "Health",
    },
    interpretation: {
      en: "Sickness, its kind and cause, and whether it will be cured. Servants, labourers and tenants; small cattle such as sheep, goats and pigs. The father's brothers and sisters.",
    },
  },
  {
    index: 7,
    zodiacId: "libra",
    motto: {
      la: "Uxor",
      en: "Wife",
    },
    interpretation: {
      en: "Marriage, a wife or husband, sweethearts and all questions of love. Open enemies: the other side in a lawsuit or a war; quarrels and duels. Thieves and theft; runaways and outlaws.",
    },
  },
  {
    index: 8,
    zodiacId: "scorpio",
    motto: {
      la: "Mors",
      en: "Death",
    },
    interpretation: {
      en: "Death, its kind and manner; the goods of the dead, wills and legacies, and who will inherit. A wife's dowry. Fear and anguish of mind.",
    },
  },
  {
    index: 9,
    zodiacId: "sagittarius",
    motto: {
      la: "Pietas",
      en: "Piety",
    },
    interpretation: {
      en: "Long journeys and voyages over the sea; foreign lands. Religion and the clergy; dreams and visions; books and learning. The kin of one's wife or husband.",
    },
  },
  {
    index: 10,
    zodiacId: "capricorn",
    motto: {
      la: "Regnum",
      en: "Kingship",
    },
    interpretation: {
