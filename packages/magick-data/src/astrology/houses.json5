    interpretation: {
      en: "Friends and friendship, and whether they are faithful; hope, trust and confidence; praise and blame. A king's favourites, counsellors and allies.",
    },
  },
  {
    index: 12,
    zodiacId: "pisces",
    motto: {
      la: "Carcer",
      en: "Prison",
    },
    interpretation: {
      en: "Secret enemies and those who work against others in secret; witches. Great cattle such as horses and oxen. Sorrow, imprisonment, every kind of affliction, and a person's own undoing.",
    },
