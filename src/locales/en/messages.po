#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "Magick.ly is a free, open-source reference and set of tools for students of Hermetic magick, as the Golden Dawn taught it and as it grew from older sources. It is a reference, not a course: nothing here replaces a teacher or a good book."
msgstr "Magick.ly is a free, open-source reference and set of tools for students of Hermetic magick, as the Golden Dawn taught it and as it grew from older sources. It is a reference, not a course: nothing here replaces a teacher or a good book."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "What's here"
msgstr "What's here"

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>Kabbalah</1></0>: an <2>interactive Tree of Life</2>, where each Sephirah and path has its own page, and the <3>72 angels of the Shem HaMephorash</3>."
msgstr "<0><1>Kabbalah</1></0>: an <2>interactive Tree of Life</2>, where each Sephirah and path has its own page, and the <3>72 angels of the Shem HaMephorash</3>."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>Golden Dawn</1></0>: the <2>grades</2> from Neophyte 0=0 to Ipsissimus 10=1, floor plans of the <3>temple halls</3>, the grade <4>rituals</4>, a <5>Rose Cross sigil generator</5> and the <6>temple symbols</6>."
msgstr "<0><1>Golden Dawn</1></0>: the <2>grades</2> from Neophyte 0=0 to Ipsissimus 10=1, floor plans of the <3>temple halls</3>, the grade <4>rituals</4>, a <5>Rose Cross sigil generator</5> and the <6>temple symbols</6>."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>Enochian</1></0>: John Dee and Edward Kelley's <2>Keys</2>, a searchable <3>dictionary</3>, the four elemental <4>tablets</4> and Dee's <5>Oration to God</5>."
msgstr "<0><1>Enochian</1></0>: John Dee and Edward Kelley's <2>Keys</2>, a searchable <3>dictionary</3>, the four elemental <4>tablets</4> and Dee's <5>Oration to God</5>."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>Astrology</1></0>: <2>planetary hours</2> for where you are, <3>moon phases</3>, the <4>planets</4> and the <5>zodiac</5>."
msgstr "<0><1>Astrology</1></0>: <2>planetary hours</2> for where you are, <3>moon phases</3>, the <4>planets</4> and the <5>zodiac</5>."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>Geomancy</1></0>: cast a <2>reading</2> and look up the <3>sixteen figures</3>."
msgstr "<0><1>Geomancy</1></0>: cast a <2>reading</2> and look up the <3>sixteen figures</3>."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>Books</1></0>: public-domain works published in full, starting with Lazare Lenain's <2>La Science Cabalistique</2> of 1823."
msgstr "<0><1>Books</1></0>: public-domain works published in full, starting with Lazare Lenain's <2>La Science Cabalistique</2> of 1823."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>Study</1></0>: spaced-repetition flashcards for Hebrew letters, planetary and zodiac signs, alchemy, Enochian and more."
msgstr "<0><1>Study</1></0>: spaced-repetition flashcards for Hebrew letters, planetary and zodiac signs, alchemy, Enochian and more."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>MagickGPT</1></0>: ask an AI that answers from a library of magickal texts and cites its sources."
msgstr "<0><1>MagickGPT</1></0>: ask an AI that answers from a library of magickal texts and cites its sources."

#. js-lingui-explicit-id
#: src/app/HomeText.tsx
msgid "<0><1>Open source</1></0>: the <2>data</2> behind the site, every table with its rows and fields, on npm as magick-data, and the <3>components</3> that draw the Tree of Life, the tablets and the sigils, each shown live with props to try, on npm as magick-components."
msgstr "<0><1>Open source</1></0>: the <2>data</2> behind the site, every table with its rows and fields, on npm as magick-data, and the <3>components</3> that draw the Tree of Life, the tablets and the sigils, each shown live with props to try, on npm as magick-components."

