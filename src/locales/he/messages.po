msgid "Agrippa prints the square in <0>De occulta philosophia</0> (Cologne, 1533), book II, chapter 22, on <1>page {page}</1>, in numbers and again in Hebrew letters, with the planet's seal and the characters of its intelligence, its spirit and its intelligences, the Bne Seraphim. Regardie's plates in <2>The Golden Dawn</2>, volume 4 (1940), draw it again, on <3>page {regardiePage}</3>."
msgstr "אגריפה מדפיס את הריבוע ב<0>De occulta philosophia</0> (קלן, 1533), ספר II, פרק 22, ב<1>עמוד {page}</1>, במספרים ושוב באותיות עבריות, עם החותם של כוכב הלכת והסימנים של התבונה שלו, של הרוח שלו ושל התבונות שלו, בני שרפים. לוחות האיורים של רגרדי ב<2>The Golden Dawn</2>, כרך 4 (1940), משרטטים אותו שוב, ב<3>עמוד {regardiePage}</3>."

#. js-lingui-explicit-id
#: src/app/astrology/kamea/kameaCopy.ts
msgid "Agrippa prints the square in <0>De occulta philosophia</0> (Cologne, 1533), book II, chapter 22, on <1>page {page}</1>, in numbers and again in Hebrew letters, with the planet's seal and the characters of its spirit, its spirit of spirits and its intelligence of intelligences. Regardie's plates in <2>The Golden Dawn</2>, volume 4 (1940), draw it again, on <3>page {regardiePage}</3>."
msgstr "אגריפה מדפיס את הריבוע ב<0>De occulta philosophia</0> (קלן, 1533), ספר II, פרק 22, ב<1>עמוד {page}</1>, במספרים ושוב באותיות עבריות, עם החותם של כוכב הלכת והסימנים של הרוח שלו, של רוח הרוחות שלו ושל תבונת התבונות שלו. לוחות האיורים של רגרדי ב<2>The Golden Dawn</2>, כרך 4 (1940), משרטטים אותו שוב, ב<3>עמוד {regardiePage}</3>."

